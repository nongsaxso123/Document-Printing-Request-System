# Copy this file to ".env" and fill in real values there.
# Never commit ".env" — it holds secrets.

PORT=3000

# Postgres connection. When running via `docker compose up`, host "db" is the
# Postgres service name (see ../docker-compose.yml). For local `npm start`
# without Docker, point this at a Postgres instance on localhost instead.
DATABASE_URL=postgresql://odprs:odprs@db:5432/odprs?schema=public
# For local `npm start` without Docker, use the host-mapped port instead:
# postgresql://odprs:odprs@localhost:5434/odprs?schema=public

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=any-long-random-string-for-local-dev

# Must exactly match an "Authorized redirect URI" on the OAuth client
# in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Only emails ending in this suffix are allowed in for real (per file.md
# BR-07). Students are on @lamduan.mfu.ac.th, so this alone already
# excludes them once ALLOW_LAMDUAN_FOR_TESTING is set back to false.
ALLOWED_EMAIL_DOMAIN=@mfu.ac.th

# TEMPORARY, for testing before a real @mfu.ac.th staff account is
# available. Set back to false once done — see file.md Appendix B.
ALLOW_LAMDUAN_FOR_TESTING=true

# TEMPORARY, exact-email allowlist for testing with a personal Google
# account regardless of domain. Leave empty outside of local dev/testing.
TEST_ALLOWED_EMAILS=

# Comma-separated list of university emails granted the Admin role.
# There's no FR for self-service Admin creation (file.md FR-02 only covers
# Admin managing Officers), so the first Admin is always bootstrapped here.
ADMIN_EMAILS=name.surname@mfu.ac.th
