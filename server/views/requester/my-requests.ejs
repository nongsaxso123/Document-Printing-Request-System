<%- include("../partials/head", { title: "คำขอของฉัน | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.myRequests", crumbFallback: "คำขอของฉัน / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="myRequests.title">คำขอของฉัน</h1>
    <p class="page-subtitle" data-i18n="myRequests.subtitle">ติดตามสถานะคำขอพิมพ์เอกสารที่คุณส่งทั้งหมด</p>

    <div class="notice notice-warning" id="pending-evaluation-notice" style="display:none;">
      <span class="icon" data-icon="info"><%- icon('info') %></span>
      <div style="flex:1;">
        <div id="pending-evaluation-message"></div>
        <div class="form-actions" style="justify-content:flex-start; margin-top:10px;">
          <a class="btn btn-primary" id="pending-evaluation-btn" href="#" data-i18n="myRequests.pendingEvaluation.evaluateBtn">ประเมินตอนนี้</a>
          <button type="button" class="btn btn-secondary" id="pending-evaluation-dismiss" data-i18n="myRequests.pendingEvaluation.laterBtn">ทีหลัง</button>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="myRequests.cardTitle">คำขอล่าสุด</span>
        <a class="btn btn-primary" href="/requester/new-request" data-i18n="myRequests.newBtn">ขอพิมพ์เอกสาร</a>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table mr-table">
          <thead>
            <tr>
              <th data-i18n="myRequests.th.ref">เลขอ้างอิง / RUN NUMBER</th>
              <th data-i18n="myRequests.th.item">รายการ</th>
              <th data-i18n="myRequests.th.submitted">วันที่ส่งคำขอ</th>
              <th data-i18n="myRequests.th.completion">วันนัดรับ</th>
              <th data-i18n="myRequests.th.status">สถานะ</th>
            </tr>
          </thead>
          <tbody id="my-requests-body"></tbody>
        </table>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  function renderRows(records) {
    const lang = getLang();
    const tbody = document.getElementById("my-requests-body");

    if (records.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state">' + t("myRequests.empty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = records.map(function (r) {
      const idLabel = r.runNumber ? (r.runNumber + " / " + r.referenceNo) : r.referenceNo;
      const completionLabel = r.completionDateConfirmed
        ? formatDate(new Date(r.completionDateConfirmed + "T00:00:00"), lang)
        : formatDate(new Date(r.completionDateProposed + "T00:00:00"), lang);

      // Classes + data-label drive the phone/tablet card layout (see
      // ".mr-table" in style.css); on a desktop this is a plain table row.
      return '<tr data-ref="' + escapeHtml(r.referenceNo) + '" tabindex="0">' +
        '<td class="mr-ref" data-label="' + escapeHtml(t("myRequests.th.ref")) + '">' + escapeHtml(idLabel) + '</td>' +
        '<td class="mr-item" data-label="' + escapeHtml(t("myRequests.th.item")) + '">' + escapeHtml(r.itemList) + '</td>' +
        '<td class="mr-date" data-label="' + escapeHtml(t("myRequests.th.submitted")) + '">' + escapeHtml(formatDateTime(new Date(r.submissionDate), lang)) + '</td>' +
        '<td class="mr-date mr-appt" data-label="' + escapeHtml(t("myRequests.th.completion")) + '">' + escapeHtml(completionLabel) + '</td>' +
        '<td class="mr-status"><span class="badge badge-' + r.statusCode + '">' + t("status." + r.statusCode) + '</span><span class="mr-chevron" aria-hidden="true">›</span></td>' +
        '</tr>';
    }).join("");

    tbody.querySelectorAll("tr[data-ref]").forEach(function (tr) {
      tr.style.cursor = "pointer";
      const open = function () {
        window.location.href = "/requester/request-submitted/" + encodeURIComponent(tr.getAttribute("data-ref"));
      };
      tr.addEventListener("click", open);
      tr.addEventListener("keydown", function (e) { if (e.key === "Enter") open(); });
    });
  }

  let myRequests = [];
  let pendingEvaluation = null;

  async function loadMyRequests() {
    const res = await fetch("/api/my-requests");
    myRequests = await res.json();
  }

  async function loadPendingEvaluation() {
    const res = await fetch("/api/my-pending-evaluation");
    pendingEvaluation = res.ok ? await res.json() : null;
  }

  // Just a reminder banner — dismissing it only hides it for this page view;
  // it reappears next visit until actually evaluated. The real enforcement
  // (blocking new-request submission) happens server-side.
  function renderPendingEvaluation() {
    const notice = document.getElementById("pending-evaluation-notice");
    if (!pendingEvaluation) {
      notice.style.display = "none";
      return;
    }
    document.getElementById("pending-evaluation-message").textContent =
      t("myRequests.pendingEvaluation.message").replace("{item}", pendingEvaluation.itemList);
    document.getElementById("pending-evaluation-btn").href =
      "/requester/evaluate/" + encodeURIComponent(pendingEvaluation.referenceNo);
    notice.style.display = "flex";
  }

  document.getElementById("pending-evaluation-dismiss").addEventListener("click", function () {
    document.getElementById("pending-evaluation-notice").style.display = "none";
  });

  document.addEventListener("odprs:langchange", function () {
    renderRows(myRequests);
    renderPendingEvaluation();
  });

  Promise.all([loadMyRequests(), loadPendingEvaluation()]).then(function () {
    renderRows(myRequests);
    renderPendingEvaluation();
  });
</script>
</body>
</html>
