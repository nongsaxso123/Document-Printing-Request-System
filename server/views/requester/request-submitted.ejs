<%- include("../partials/head", { title: "ODPRS — ส่งคำขอสำเร็จ" }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.submitted", crumbFallback: "สร้างคำขอพิมพ์เอกสาร / <strong>ส่งคำขอสำเร็จ</strong>" }) %>

  <main class="app-main">
    <div class="no-print">
      <h1 class="page-title" data-i18n="submitted.title">ส่งคำขอสำเร็จ</h1>
      <p class="page-subtitle" data-i18n="submitted.subtitle">กรุณาพิมพ์ใบคำขอด้านล่างและนำไปพร้อมกับเอกสารต้นฉบับ</p>

      <div class="notice notice-warning" id="deadline-notice">
        <span class="icon" data-icon="clock" id="deadline-icon"></span>
        <div>
          <strong id="deadline-title" data-i18n="submitted.deadline.label">นำเอกสารต้นฉบับมาส่งภายใน:</strong> <span id="deadline-label">—</span><br>
          <span id="deadline-body" data-i18n="submitted.deadline.body">หากไม่นำมาส่งภายในกำหนด คำขอจะยังคงค้างสถานะ "รอส่งเอกสารต้นฉบับ" — กรุณาติดต่อเจ้าหน้าที่หากมีปัญหา</span>
        </div>
      </div>
    </div>

    <div class="card" id="request-form-card">
      <div class="card-header no-print">
        <span data-i18n="submitted.formCardTitle">ใบคำขอพิมพ์เอกสาร (สำหรับพิมพ์)</span>
        <div style="display:flex; gap:10px;">
          <a class="btn btn-secondary" href="/requester/request-submitted/<%= encodeURIComponent(record.referenceNo) %>/pdf" target="_blank">
            <span class="icon" data-icon="download"></span>
            <span data-i18n="submitted.downloadPdfBtn">ดาวน์โหลด PDF</span>
          </a>
          <button class="btn btn-primary" onclick="window.print()">
            <span class="icon" data-icon="printer"></span>
            <span data-i18n="submitted.printBtn">พิมพ์ใบคำขอ</span>
          </button>
        </div>
      </div>
      <div class="card-body print-doc">
        <%- include("../partials/print-form") %>
      </div>
    </div>

    <div class="form-actions no-print">
      <a class="btn btn-secondary" href="/requester/new-request" data-i18n="submitted.newBtn">สร้างคำขอใหม่</a>
      <a class="btn btn-primary" href="/requester/my-requests" data-i18n="submitted.goToMyRequests">ไปที่คำขอของฉัน</a>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  const data = <%- JSON.stringify(record) %>;

  function renderDeadlineNotice(lang) {
    const noticeEl = document.getElementById("deadline-notice");
    const titleEl = document.getElementById("deadline-title");
    const bodyEl = document.getElementById("deadline-body");
    const labelEl = document.getElementById("deadline-label");

    if (data.originalDocReceivedTimestamp) {
      // Officer has already confirmed receipt (FR-10) — the "bring it by
      // today" prompt no longer applies, ever, regardless of when this
      // page is revisited.
      noticeEl.style.display = "";
      noticeEl.classList.remove("notice-warning");
      noticeEl.classList.add("notice-success");
      document.getElementById("deadline-icon").setAttribute("data-icon", "check-circle");
      applyIcons();
      titleEl.textContent = t("submitted.deadline.received.label");
      labelEl.textContent = formatDateTime(new Date(data.originalDocReceivedTimestamp), lang);
      bodyEl.textContent = t("submitted.deadline.received.body");
      return;
    }

    if (data.statusCode !== "awaiting") {
      // Rejected before the original document was ever received — the
      // drop-off prompt no longer makes sense either.
      noticeEl.style.display = "none";
      return;
    }

    noticeEl.style.display = "";
    noticeEl.classList.remove("notice-success");
    noticeEl.classList.add("notice-warning");
    document.getElementById("deadline-icon").setAttribute("data-icon", "clock");
    applyIcons();
    titleEl.textContent = t("submitted.deadline.label");
    bodyEl.textContent = t("submitted.deadline.body");
    labelEl.textContent = formatDropoffLabel(dropoffInfoFor(lang), lang);
  }

  // "Today" must reflect the actual current date, not a frozen fact about
  // submission day vs. deadline day — otherwise revisiting this page after
  // the deadline has passed still (wrongly) says "today".
  function dropoffInfoFor() {
    const deadlineDate = new Date(data.dropoffDeadlineDate);
    const sameDay = new Date().toDateString() === deadlineDate.toDateString();
    return { date: deadlineDate, sameDay };
  }

  function render() {
    const lang = getLang();
    renderDeadlineNotice(lang);
    renderPrintForm(data);
  }

  document.addEventListener("odprs:langchange", render);
  render();
</script>
</body>
</html>
