<%- include("../partials/head", { title: "ODPRS — ส่งคำขอสำเร็จ" }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.submitted", crumbFallback: "สร้างคำขอพิมพ์เอกสาร / <strong>ส่งคำขอสำเร็จ</strong>" }) %>

  <main class="app-main">
    <div class="no-print">
      <h1 class="page-title" data-i18n="submitted.title">ส่งคำขอสำเร็จ</h1>
      <p class="page-subtitle" data-i18n="submitted.subtitle">กรุณาพิมพ์ใบคำขอด้านล่างและนำไปพร้อมกับเอกสารต้นฉบับ</p>

      <div class="notice notice-warning" id="deadline-notice">
        <span class="icon" data-icon="clock"></span>
        <div>
          <strong data-i18n="submitted.deadline.label">นำเอกสารต้นฉบับมาส่งภายใน:</strong> <span id="deadline-label">—</span><br>
          <span data-i18n="submitted.deadline.body">หากไม่นำมาส่งภายในกำหนด คำขอจะยังคงค้างสถานะ "รอส่งเอกสารต้นฉบับ" — กรุณาติดต่อเจ้าหน้าที่หากมีปัญหา</span>
        </div>
      </div>
    </div>

    <div class="card" id="request-form-card">
      <div class="card-header no-print">
        <span data-i18n="submitted.formCardTitle">ใบคำขอพิมพ์เอกสาร (สำหรับพิมพ์)</span>
        <div style="display:flex; gap:10px;">
          <a class="btn btn-secondary" href="/requester/request-submitted/<%= encodeURIComponent(record.referenceNo) %>/pdf" target="_blank">
            <span class="icon" data-icon="download"></span>
            <span data-i18n="submitted.downloadPdfBtn">ดาวน์โหลด PDF</span>
          </a>
          <button class="btn btn-primary" onclick="window.print()">
            <span class="icon" data-icon="printer"></span>
            <span data-i18n="submitted.printBtn">พิมพ์ใบคำขอ</span>
          </button>
        </div>
      </div>
      <div class="card-body">
        <div style="text-align:center; margin-bottom:20px;">
          <div style="font-weight:700; font-size:18px;" data-i18n="submitted.formHeading">ใบคำขอพิมพ์เอกสาร — ODPRS</div>
          <div style="color:var(--color-muted); font-size:13px;" data-i18n="submitted.formSub">ฝ่ายทะเบียน มหาวิทยาลัยแม่ฟ้าหลวง</div>
        </div>
        <dl class="summary-list">
          <dt data-i18n="summary.refno">เลขอ้างอิงคำขอ</dt><dd id="s-refno">—</dd>
          <dt data-i18n="summary.name">ชื่อผู้ขอ</dt><dd id="s-name">—</dd>
          <dt data-i18n="summary.agencyCategory">ประเภทหน่วยงาน</dt><dd id="s-agency-category">—</dd>
          <dt data-i18n="summary.agencyUnit">หน่วยงาน</dt><dd id="s-agency-unit">—</dd>
          <dt data-i18n="summary.tel">เบอร์โทรศัพท์</dt><dd id="s-tel">—</dd>
          <dt data-i18n="summary.documentType">ประเภทเอกสาร</dt><dd id="s-documenttype">—</dd>
          <dt data-i18n="summary.paperSize">ขนาดกระดาษ</dt><dd id="s-papersize">—</dd>
          <dt data-i18n="summary.colorMode">โหมดสี</dt><dd id="s-colormode">—</dd>
          <dt data-i18n="summary.printSide">รูปแบบการพิมพ์ (หน้า)</dt><dd id="s-printside">—</dd>
          <dt data-i18n="summary.finishingMethod">งานตกแต่ง / การเข้าเล่ม</dt><dd id="s-finishing">—</dd>
          <dt data-i18n="summary.itemList">รายการเอกสาร</dt><dd id="s-itemlist">—</dd>
          <dt data-i18n="summary.pages">จำนวนหน้าต้นฉบับ</dt><dd id="s-pages">—</dd>
          <dt data-i18n="summary.copies">จำนวนชุด</dt><dd id="s-copies">—</dd>
          <dt data-i18n="summary.totalPages">จำนวนหน้าที่ต้องพิมพ์ทั้งหมด (หน้าต้นฉบับ × จำนวนชุด)</dt><dd id="s-totalpages">—</dd>
          <dt data-i18n="newRequest.calc.totalSheets">จำนวนแผ่นกระดาษที่ต้องใช้ทั้งหมด</dt><dd id="s-totalsheets">—</dd>
          <dt data-i18n="summary.paperSource">การจัดเตรียมกระดาษ</dt><dd id="s-paperresponsibility">—</dd>
          <dt data-i18n="summary.copyLabel">เลขรันประจำชุด (Copy Label)</dt><dd id="s-copylabel">—</dd>
          <dt data-i18n="summary.submitted">วันที่ส่งคำขอ</dt><dd id="s-submitted">—</dd>
          <dt data-i18n="summary.completion">วันที่ต้องการรับเอกสาร</dt><dd id="s-completion">—</dd>
          <dt data-i18n="summary.deadline">กำหนดส่งเอกสารต้นฉบับ</dt><dd id="s-deadline">—</dd>
          <dt data-i18n="summary.status">สถานะ</dt><dd><span class="badge badge-awaiting" id="s-status" data-i18n="status.awaiting">รอส่งเอกสารต้นฉบับ</span></dd>
        </dl>
      </div>
    </div>

    <div class="form-actions no-print">
      <a class="btn btn-secondary" href="/requester/new-request" data-i18n="submitted.newBtn">สร้างคำขอใหม่</a>
      <a class="btn btn-primary" href="/requester/my-requests" data-i18n="submitted.goToMyRequests">ไปที่คำขอของฉัน</a>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  const data = <%- JSON.stringify(record) %>;

  function render() {
    const lang = getLang();
    const sameDay = new Date(data.submissionDate).toDateString() === new Date(data.dropoffDeadlineDate).toDateString();
    const dropoffInfo = { date: new Date(data.dropoffDeadlineDate), sameDay };
    const deadlineLabel = formatDropoffLabel(dropoffInfo, lang);

    document.getElementById("deadline-label").textContent = deadlineLabel;
    document.getElementById("s-refno").textContent = data.referenceNo;
    document.getElementById("s-name").textContent = data.requesterName;
    document.getElementById("s-agency-category").textContent = lang === "en"
      ? (AGENCY_CATEGORY_EN[data.agencyCategory] || data.agencyCategory)
      : data.agencyCategory;
    document.getElementById("s-agency-unit").textContent = data.agencyUnit;
    document.getElementById("s-tel").textContent = data.tel;
    document.getElementById("s-documenttype").textContent = translateValue(data.documentType);
    document.getElementById("s-papersize").textContent = translateValue(data.paperSize);
    document.getElementById("s-colormode").textContent = translateValue(data.colorMode);
    document.getElementById("s-printside").textContent = translateValue(data.printSide);
    document.getElementById("s-finishing").textContent = translateList(data.finishing);
    document.getElementById("s-itemlist").textContent = data.itemList;
    document.getElementById("s-pages").textContent = data.originalPages;
    document.getElementById("s-copies").textContent = data.copies;
    const numFmt = lang === "en" ? "en-US" : "th-TH";
    document.getElementById("s-totalpages").textContent = (Number(data.originalPages) * Number(data.copies)).toLocaleString(numFmt);
    const totalSheets = computeTotalSheets(data.originalPages, data.copies, data.printSide);
    document.getElementById("s-totalsheets").textContent = totalSheets.toLocaleString(numFmt);
    document.getElementById("s-paperresponsibility").textContent = paperResponsibilityText(data.paperSource, totalSheets, lang);
    const copyLabelRange = data.copyLabelEnabled ? copyLabelRangeText(data.copyLabelPrefix, data.copyLabelStart, data.copies) : null;
    document.getElementById("s-copylabel").textContent = copyLabelRange || t("option.none");
    document.getElementById("s-submitted").textContent = formatDateTime(new Date(data.submissionDate), lang);
    document.getElementById("s-completion").textContent = formatDate(new Date(data.completionDateProposed + "T00:00:00"), lang);
    document.getElementById("s-deadline").textContent = deadlineLabel;

    const statusEl = document.getElementById("s-status");
    statusEl.textContent = t("status." + data.statusCode);
    statusEl.className = "badge badge-" + data.statusCode;
  }

  document.addEventListener("odprs:langchange", render);
  render();
</script>
</body>
</html>
