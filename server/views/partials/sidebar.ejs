<aside class="app-sidebar" id="app-sidebar" data-nav-scope="<%= typeof navScope !== "undefined" ? navScope : "" %>">
  <a class="brand" href="<%= user.role === 'Requester' ? '/requester/my-requests' : user.role === 'Admin' ? '/admin/officers' : '/officer/queue' %>" title="กลับหน้าแรก">
    <img class="mark" src="/assets/images/mfu-logo.png" alt="Mae Fah Luang University">
    <div class="brand-text">
      <div class="name">ODPR</div>
      <div class="tagline" data-i18n="brand.tagline">ระบบขอพิมพ์เอกสารออนไลน์</div>
      <div class="sub" data-i18n="brand.sub">ฝ่ายทะเบียน มฟล.</div>
    </div>
  </a>

  <% if (user.role === "Admin") { %>
  <div class="nav-section nav-section-admin" data-nav-section="admin">
    <button type="button" class="nav-section-label">
      <span data-i18n="nav.section.admin">สำหรับผู้ดูแลระบบ</span>
      <span class="icon chevron" data-icon="chevron-down"><%- icon('chevron-down') %></span>
    </button>
    <div class="nav-section-items">
      <div class="nav-subhead" data-i18n="nav.group.system">บัญชีและระบบ</div>
      <a class="nav-item <%= active === "admin" ? "active" : "" %>" href="/admin/officers">
        <span class="icon" data-icon="users"><%- icon('users') %></span> <span data-i18n="nav.adminOfficers">จัดการบัญชีเจ้าหน้าที่</span>
      </a>
      <a class="nav-item <%= active === "systemSettings" ? "active" : "" %>" href="/admin/settings">
        <span class="icon" data-icon="settings"><%- icon('settings') %></span> <span data-i18n="nav.adminSettings">จัดการระบบ</span>
      </a>
      <a class="nav-item <%= active === "adminAuditLog" ? "active" : "" %>" href="/admin/audit-log">
        <span class="icon" data-icon="clock"><%- icon('clock') %></span> <span data-i18n="nav.adminAuditLog">ประวัติการแก้ไข</span>
      </a>
      <div class="nav-subhead" data-i18n="nav.group.reference">ข้อมูลพื้นฐาน</div>
      <a class="nav-item <%= active === "adminLocations" ? "active" : "" %>" href="/admin/locations">
        <span class="icon" data-icon="map-pin"><%- icon('map-pin') %></span> <span data-i18n="nav.adminLocations">สถานที่รับ-ส่งเอกสาร</span>
      </a>
      <a class="nav-item <%= active === "adminAgencies" ? "active" : "" %>" href="/admin/agencies">
        <span class="icon" data-icon="package"><%- icon('package') %></span> <span data-i18n="nav.adminAgencies">หน่วยงาน</span>
      </a>
      <a class="nav-item <%= active === "adminManuals" ? "active" : "" %>" href="/admin/manuals">
        <span class="icon" data-icon="book-open"><%- icon('book-open') %></span> <span data-i18n="nav.adminManuals">คู่มือการใช้งาน</span>
      </a>
    </div>
  </div>
  <% } %>

  <% if (user.role === "Requester" || user.role === "Admin") { %>
  <div class="nav-section" data-nav-section="requester"<%= user.role === "Admin" ? " data-default-collapsed" : "" %>>
    <button type="button" class="nav-section-label">
      <span data-i18n="nav.section.requester">สำหรับผู้ขอ</span>
      <span class="icon chevron" data-icon="chevron-down"><%- icon('chevron-down') %></span>
    </button>
    <div class="nav-section-items">
      <a class="nav-item <%= active === "myRequests" ? "active" : "" %>" href="/requester/my-requests">
        <span class="icon" data-icon="clipboard"><%- icon('clipboard') %></span> <span data-i18n="nav.myRequests">คำขอของฉัน</span>
      </a>
      <a class="nav-item <%= active === "newRequest" ? "active" : "" %>" href="/requester/new-request">
        <span class="icon" data-icon="file-plus"><%- icon('file-plus') %></span> <span data-i18n="nav.newRequest">สร้างคำขอพิมพ์เอกสาร</span>
      </a>
    </div>
  </div>
  <% } %>

  <% if (user.role === "Officer" || user.role === "Admin") { %>
  <div class="nav-section" data-nav-section="officer"<%= user.role === "Admin" ? " data-default-collapsed" : "" %>>
    <button type="button" class="nav-section-label">
      <span data-i18n="nav.section.officer">สำหรับเจ้าหน้าที่</span>
      <span class="icon chevron" data-icon="chevron-down"><%- icon('chevron-down') %></span>
    </button>
    <div class="nav-section-items">
      <a class="nav-item <%= active === "queue" ? "active" : "" %>" href="/officer/queue">
        <span class="icon" data-icon="inbox"><%- icon('inbox') %></span> <span data-i18n="nav.officerQueue">คิวรอเอกสารต้นฉบับ</span>
      </a>
      <a class="nav-item <%= active === "printing" ? "active" : "" %>" href="/officer/printing-jobs">
        <span class="icon" data-icon="printer"><%- icon('printer') %></span> <span data-i18n="nav.printingJobs">งานที่กำลังปริ้น</span>
      </a>
      <a class="nav-item <%= active === "handover" ? "active" : "" %>" href="/officer/counter-handover">
        <span class="icon" data-icon="user-check"><%- icon('user-check') %></span> <span data-i18n="nav.counterHandover">จุดส่งมอบเอกสาร</span>
      </a>
      <a class="nav-item <%= active === "history" ? "active" : "" %>" href="/officer/history">
        <span class="icon" data-icon="archive"><%- icon('archive') %></span> <span data-i18n="nav.history">ประวัติคำขอทั้งหมด</span>
      </a>
      <div class="nav-item-divider"></div>
      <a class="nav-item <%= active === "dashboard" ? "active" : "" %>" href="/officer/dashboard">
        <span class="icon" data-icon="bar-chart"><%- icon('bar-chart') %></span> <span data-i18n="nav.dashboard">แดชบอร์ดสรุปข้อมูล</span>
      </a>
      <a class="nav-item <%= active === "evaluations" ? "active" : "" %>" href="/officer/evaluations">
        <span class="icon" data-icon="star"><%- icon('star') %></span> <span data-i18n="nav.evaluations">ผลประเมินความพึงพอใจ</span>
      </a>
    </div>
  </div>
  <% } %>

  <% if (user.role === "Admin") { %>
  <div class="nav-footer">
    <a class="nav-item <%= active === "adminBackup" ? "active" : "" %>" href="/admin/backup">
      <span class="icon" data-icon="database"><%- icon('database') %></span> <span data-i18n="nav.adminBackup">สำรองและกู้คืนข้อมูล</span>
    </a>
  </div>
  <% } %>
</aside>
