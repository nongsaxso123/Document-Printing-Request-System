<!--
  Shared Request Form print/PDF content, included identically by both
  officer/request-form-view.ejs and requester/request-submitted.ejs — the
  printed form represents one physical document the Requester fills and
  hands to the Officer, so both sides must see the same content.
  Structure ported from ref and logos/wireframes/printing-request-form-redesign.html
  (its .ph-* classes, renamed here to .print-*). Populated by
  renderPrintForm(record) in app.js (all ids prefixed "pf-").

  Two faces: ON SCREEN it follows the TH/EN toggle like every other page;
  when PRINTED or turned into the PDF it is the fixed bilingual official
  document (header in English, body "Thai (English)"). The hardcoded text
  below IS the print wording; data-pf-label="<i18n key>" gives the screen
  wording. renderPrintForm() renders both and CSS (.pf-screen/.pf-print)
  shows the right one, so it works for window.print() and the puppeteer
  PDF alike (that one never fires beforeprint).
-->
<div class="print-header">
  <img class="print-logo" src="/assets/images/mfu-logo.png" alt="Mae Fah Luang University">
  <div class="print-org-en" data-pf-label="pf.org">Registrar Division, Mae Fah Luang University</div>
  <div class="print-doc-title" data-pf-label="pf.title">Document Printing Request Form</div>
  <div class="print-salutation" data-pf-label="pf.salutation">To Head of the Registrar Division</div>
</div>

<div class="print-section-label" data-pf-label="pf.sec.requester">ข้อมูลผู้ขอ (Requester Information)</div>
<table class="print-field-table">
  <tr>
    <th data-pf-label="pf.name">ชื่อผู้ขอ (Name)</th><td id="pf-name">—</td>
    <th data-pf-label="pf.tel">เบอร์โทรศัพท์ (Tel.)</th><td id="pf-tel">—</td>
  </tr>
  <tr><th data-pf-label="pf.unit">หน่วยงาน (Unit)</th><td colspan="3" id="pf-unit">—</td></tr>
  <tr><th data-pf-label="pf.unitType">ประเภทหน่วยงาน (Unit Type)</th><td colspan="3" id="pf-unit-type">—</td></tr>
</table>

<div class="print-section-label" data-pf-label="pf.sec.print">ข้อมูลการพิมพ์ (Print Specification)</div>
<table class="print-field-table">
  <tr>
    <th data-pf-label="pf.documentType">ประเภทเอกสาร (Document Type)</th><td id="pf-documenttype">—</td>
    <th data-pf-label="pf.paperSize">ขนาดกระดาษ (Paper Size)</th><td id="pf-papersize">—</td>
  </tr>
  <tr>
    <th data-pf-label="pf.colorMode">โหมดสี (Color Mode)</th><td id="pf-colormode">—</td>
    <th data-pf-label="pf.printSide">รูปแบบการพิมพ์ (Print Side)</th><td id="pf-printside">—</td>
  </tr>
  <tr><th data-pf-label="pf.finishing">งานตกแต่ง / การเข้าเล่ม (Finishing / Binding)</th><td colspan="3" id="pf-finishing">—</td></tr>
  <tr><th data-pf-label="pf.paperSource">การจัดเตรียมกระดาษ (Paper Source)</th><td colspan="3" id="pf-paperresponsibility">—</td></tr>
  <tr><th data-pf-label="pf.copyLabel">เลขรันประจำชุด (Copy Label)</th><td colspan="3" id="pf-copylabel">—</td></tr>
</table>

<div class="print-section-label" data-pf-label="pf.sec.items">รายการที่ขอผลิต (Items Requested)</div>
<table class="print-item-table">
  <thead>
    <tr>
      <th data-pf-label="pf.ref">เลขอ้างอิง / RUN NUMBER</th>
      <th data-pf-label="pf.items">รายการเอกสาร (Items)</th>
      <th data-pf-label="pf.pages">หน้าต้นฉบับ (Orig. Pages)</th>
      <th data-pf-label="pf.copies">จำนวนชุด (Copies)</th>
      <th data-pf-label="pf.totalPages">รวมหน้าพิมพ์ (Total Pages)</th>
      <th data-pf-label="pf.totalSheets">รวมแผ่นกระดาษ (Total Sheets)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="pf-cell-ref" data-label="เลขอ้างอิง / RUN NUMBER" data-pf-cell="pf.ref">
        <span id="pf-refno">—</span>
        <small id="pf-runno" style="display:none;"></small>
      </td>
      <td class="pf-cell-items" id="pf-itemlist" data-label="รายการเอกสาร (Items)" data-pf-cell="pf.items">—</td>
      <td class="num" id="pf-pages" data-label="หน้าต้นฉบับ (Orig. Pages)" data-pf-cell="pf.pages">—</td>
      <td class="num" id="pf-copies" data-label="จำนวนชุด (Copies)" data-pf-cell="pf.copies">—</td>
      <td class="num" id="pf-totalpages" data-label="รวมหน้าพิมพ์ (Total Pages)" data-pf-cell="pf.totalPages">—</td>
      <td class="num" id="pf-totalsheets" data-label="รวมแผ่นกระดาษ (Total Sheets)" data-pf-cell="pf.totalSheets">—</td>
    </tr>
  </tbody>
</table>

<div class="print-requester-line">
  <span class="pf-meta"><span class="k" data-pf-label="pf.requester">ผู้ขอ (Requester)</span> <span id="pf-requester-name">—</span></span>
  <span class="pf-sep" aria-hidden="true"></span>
  <span class="pf-meta"><span class="k" data-pf-label="pf.submitted">ส่งเมื่อ (Submitted)</span> <span id="pf-submitted">—</span></span>
</div>

<table class="print-field-table print-approval-table">
  <tr>
    <th data-pf-label="pf.officer">เจ้าหน้าที่ (Officer)</th>
    <th data-pf-label="pf.receiver">ผู้รับเอกสาร (Receiver)</th>
  </tr>
  <tr>
    <td id="pf-signoff-officer"></td>
    <td id="pf-signoff-receiver"></td>
  </tr>
</table>

<div class="print-footnote" id="pf-footnote"></div>
