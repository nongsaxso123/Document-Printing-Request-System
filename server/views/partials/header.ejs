  <div class="nav-backdrop" id="nav-backdrop" hidden></div>
  <header class="app-header">
    <div class="header-lead">
      <button type="button" class="nav-toggle" id="nav-toggle" aria-controls="app-sidebar" aria-expanded="false" data-i18n-title="nav.menu" title="เมนู">
        <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
      <div class="crumb" data-i18n="<%= crumbKey %>"><%- crumbFallback %></div>
    </div>
    <div class="header-actions">
      <div class="lang-toggle">
        <span data-lang="en">EN</span> / <span data-lang="th" class="active">TH</span>
      </div>
      <div class="notif-wrap">
        <button type="button" class="notif-bell-btn" id="notif-bell-btn" data-i18n-title="notif.title" title="การแจ้งเตือน">
          <span class="icon" data-icon="bell"><%- icon('bell') %></span>
          <span class="notif-badge" id="notif-badge" hidden>0</span>
        </button>
        <div class="notif-dropdown" id="notif-dropdown" hidden>
          <div class="notif-dropdown-header">
            <span data-i18n="notif.title">การแจ้งเตือน</span>
            <button type="button" class="notif-mark-all-btn" id="notif-mark-all-btn" data-i18n="notif.markAllRead">อ่านทั้งหมด</button>
          </div>
          <div class="notif-list" id="notif-list"></div>
        </div>
      </div>
      <a class="user-chip" href="/profile" data-i18n-title="profile.linkTitle" title="แก้ไขโปรไฟล์">
        <% if (user.picture) { %>
        <div class="avatar"><img src="<%= user.picture %>" alt="" referrerpolicy="no-referrer"></div>
        <% } else { %>
        <div class="avatar"><%= user.name.trim().split(/\s+/).map(w => w[0]).slice(0, 2).join("").toUpperCase() %></div>
        <% } %>
        <div class="who">
          <span><%= user.name %></span>
          <small><span data-i18n="user.role.<%= user.role.toLowerCase() %>"><%= user.role %></span> · <%= user.email %></small>
        </div>
      </a>
      <a class="logout-link" href="/logout" title="Log out" data-i18n-title="user.logout">
        <span class="icon" data-icon="log-out"><%- icon('log-out') %></span>
      </a>
    </div>
  </header>
