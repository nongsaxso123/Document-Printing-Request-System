<%- include("../partials/head", { title: "งานที่อยู่ระหว่างพิมพ์ | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.printingJobs", crumbFallback: 'งานที่กำลังปริ้น / <strong>ภาพรวม</strong>' }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="printingJobs.title">งานที่กำลังปริ้น</h1>
    <p class="page-subtitle" data-i18n="printingJobs.subtitle">คำขอที่อนุมัติแล้วและกำลังพิมพ์/แพ็กเอกสารอยู่</p>

    <div class="card">
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="printingJobs.th.runno">RUN NUMBER</th>
              <th data-i18n="printingJobs.th.requester">ผู้ขอ</th>
              <th data-i18n="printingJobs.th.item">รายการ</th>
              <th data-i18n="printingJobs.th.totalPages">จำนวนหน้ารวม</th>
              <th data-i18n="printingJobs.th.completion">วันนัดรับ (ยืนยันแล้ว)</th>
              <th data-i18n="printingJobs.th.action">การดำเนินการ</th>
            </tr>
          </thead>
          <tbody id="printing-body"></tbody>
        </table>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<%# Calendar markup cloned into the "mark ready" dialog (buildReadyFields). %>
<template id="ready-date-template">
  <%- include("../partials/date-picker", { id: "ready-date", name: "readyDate" }) %>
</template>
<template id="ready-time-template">
  <%- include("../partials/time-wheel", { id: "ready-time" }) %>
</template>
<script>
  // Filtered server-side (small, naturally-bounded list) instead of
  // fetching every request in the system just to pick out the printing ones.
  async function loadRequests() {
    const res = await fetch("/api/requests/printing");
    return res.json();
  }

  // Places an Officer can name as the pickup point (src/locations.js).
  async function loadPickupOptions() {
    const res = await fetch("/api/locations/pickup");
    return res.ok ? res.json() : [];
  }

  const PICKUP_MAX_DAYS = 366; // same limit as resolvePickupTime() on the server
  const TIME_STEP = 15;        // minutes between the minute choices

  function pad2(n) { return String(n).padStart(2, "0"); }
  function hhmm(totalMinutes) { return pad2(Math.floor(totalMinutes / 60)) + ":" + pad2(totalMinutes % 60); }

  // Body of the "mark ready" dialog:
  //   top    the job at a glance (RUN NUMBER, requester, items, pages)
  //   left   calendar: any day from today, the officer decides
  //   right  pickup place, then "available now" or a time (clock wheel, 15 min)
  // The requester is still told the place's own opening hours (see
  // messages.ready on the server), so a weekend or late time is the
  // officer's call, not a rule. Returns the getter showConfirmModal calls.
  function buildReadyFields(container, pickupOptions, defaultPickup, lang, record) {
    // Own wrapper for the layout: the dialog's .modal-extra is shared by
    // every popup, so it must not carry this page's classes.
    const layout = document.createElement("div");
    layout.className = "ready-layout";
    container.appendChild(layout);

    // ---- job summary: who/what on the left, how much on the right ----
    const total = Number(record.originalPages) * Number(record.copies);
    const numFmt = function (n) { return Number(n).toLocaleString(lang === "en" ? "en-US" : "th-TH"); };
    const summary = document.createElement("div");
    summary.className = "ready-job";
    summary.innerHTML =
      '<div class="ready-job-main">' +
        '<div class="ready-job-head"><span class="ready-job-run">' + escapeHtml(record.runNumber || "") + '</span>' +
          '<span class="ready-job-name">' + escapeHtml(record.requesterName || "") + '</span></div>' +
        '<div class="ready-job-item">' + escapeHtml(record.itemList || "") + '</div>' +
      '</div>' +
      '<div class="ready-job-pages">' +
        '<span class="ready-job-total">' + escapeHtml(numFmt(total)) + '</span>' +
        '<span class="ready-job-unit">' + escapeHtml(t("printingJobs.pagesUnit")) + '</span>' +
        '<span class="ready-job-break">' + escapeHtml(t("printingJobs.pagesBreakdownShort").replace("{pages}", record.originalPages).replace("{copies}", record.copies)) + '</span>' +
      '</div>';
    layout.appendChild(summary);

    function fieldWith(labelText, control, cls) {
      const wrap = document.createElement("div");
      wrap.className = "field " + cls;
      const label = document.createElement("label");
      label.textContent = labelText;
      wrap.appendChild(label);
      wrap.appendChild(control);
      layout.appendChild(wrap);
      return wrap;
    }

    // ---- place ----
    let placeSelect = null;
    if (pickupOptions.length > 0) {
      placeSelect = document.createElement("select");
      pickupOptions.forEach(function (p) { placeSelect.add(new Option(formatLocation(p, lang), String(p.id))); });
      if (defaultPickup) placeSelect.value = String(defaultPickup.id);
      fieldWith(t("printingJobs.pickupLabel"), placeSelect, "ready-place-field");
    }
    function currentHours() {
      const place = placeSelect ? pickupOptions.find(function (p) { return String(p.id) === placeSelect.value; }) : null;
      const w = hourWindowOf(place);
      return { start: w ? w.start : BUSINESS_HOUR_START, end: w ? w.end : BUSINESS_HOUR_END };
    }

    // ---- date: calendar, any day from today ----
    const dateTpl = document.getElementById("ready-date-template").content.cloneNode(true);
    const picker = createDatePicker(dateTpl.querySelector(".date-picker"), {
      minDate: new Date(),
      inline: true,
      isSelectable: function (date) {
        const today = new Date(); today.setHours(0, 0, 0, 0);
        return (date - today) / 86400000 <= PICKUP_MAX_DAYS;
      },
      onChange: syncTime
    });
    picker.setDate(new Date());
    fieldWith(t("printingJobs.pickupDateLabel"), dateTpl, "ready-date-field");

    // ---- time: "now" or a set time ----
    const timeBox = document.createElement("div");
    timeBox.className = "ready-time";
    timeBox.innerHTML =
      '<div class="radio-group ready-time-mode">' +
        '<label class="radio-option" id="ready-now-opt"><input type="radio" name="ready-mode" value="now"> <span>' + escapeHtml(t("printingJobs.availableNow")) + '</span></label>' +
        '<label class="radio-option"><input type="radio" name="ready-mode" value="at"> <span>' + escapeHtml(t("printingJobs.setTime")) + '</span></label>' +
      '</div>';
    // Clock wheel shown in place (inline), 3 rows tall, 15-minute steps.
    const timeTpl = document.getElementById("ready-time-template").content.cloneNode(true);
    const clock = timeTpl.querySelector(".time-wheel");
    timeBox.appendChild(timeTpl);
    const hint = document.createElement("p");
    hint.className = "ready-hint";
    timeBox.appendChild(hint);
    fieldWith(t("printingJobs.pickupTimeLabel"), timeBox, "ready-time-field");

    const wheel = createTimeWheel(clock, { value: hhmm(Math.round(currentHours().start * 60)), minuteStep: TIME_STEP, inline: true });
    function setClock(totalMinutes) {
      const m = Math.round(totalMinutes / TIME_STEP) * TIME_STEP;
      wheel.set(hhmm(m % (24 * 60)));
    }
    const nowRadio = timeBox.querySelector('input[value="now"]');
    const atRadio = timeBox.querySelector('input[value="at"]');
    // The dialog appears right after this builder returns; scroll the
    // wheels to their value once they are actually on screen.
    setTimeout(function () { wheel.refresh(); }, 0);

    function isTodayPicked() {
      const d = picker.getDate();
      const n = new Date();
      return d && d.getFullYear() === n.getFullYear() && d.getMonth() === n.getMonth() && d.getDate() === n.getDate();
    }
    // "Available now" only makes sense for today; another day needs a time,
    // which starts at the place's opening time.
    function syncTime() {
      const today = isTodayPicked();
      document.getElementById("ready-now-opt").hidden = !today;
      if (!today && nowRadio.checked) {
        atRadio.checked = true;
        setClock(Math.round(currentHours().start * 60));
      }
      if (!nowRadio.checked && !atRadio.checked) (today ? nowRadio : atRadio).checked = true;
      wheel.setDisabled(nowRadio.checked);
      const h = currentHours();
      hint.textContent = t("printingJobs.hoursHint").replace("{hours}", formatClockHour(h.start) + "–" + formatClockHour(h.end));
    }
    timeBox.addEventListener("change", syncTime);
    if (placeSelect) placeSelect.addEventListener("change", syncTime);
    applyIcons();
    syncTime();

    return function getValue() {
      let availableFrom; // undefined = available now (server decides)
      const d = picker.getDate();
      if (d && atRadio.checked) {
        const parts = wheel.get().split(":").map(Number);
        const at = new Date(d.getFullYear(), d.getMonth(), d.getDate(), parts[0], parts[1]);
        // A time already past today simply means "now".
        if (at > new Date()) availableFrom = at.toISOString();
      }
      return { pickupLocationId: placeSelect ? placeSelect.value : undefined, pickupAvailableFrom: availableFrom };
    };
  }

  async function renderPrintingJobs() {
    const lang = getLang();
    // Soonest confirmed pickup date first, so Officers prioritize printing
    // jobs by how urgently they're due rather than by intake order.
    const records = (await loadRequests())
      .sort(function (a, b) { return new Date(a.completionDateConfirmed) - new Date(b.completionDateConfirmed); });

    const tbody = document.getElementById("printing-body");

    if (records.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">' + t("printingJobs.empty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = records.map(function (r) {
      const total = Number(r.originalPages) * Number(r.copies);
      const totalLabel = t("printingJobs.totalPagesUnit").replace("{total}", total.toLocaleString(lang === "en" ? "en-US" : "th-TH"));
      const breakdownLabel = t("printingJobs.pagesBreakdown").replace("{pages}", r.originalPages).replace("{copies}", r.copies);

      return '<tr data-ref="' + escapeHtml(r.referenceNo) + '">' +
        '<td>' + escapeHtml(r.runNumber) + '</td>' +
        '<td>' + escapeHtml(r.requesterName) + '</td>' +
        '<td>' + escapeHtml(r.itemList) + '</td>' +
        '<td>' +
          '<div style="font-weight:700;">' + escapeHtml(totalLabel) + '</div>' +
          '<div class="hint">' + escapeHtml(breakdownLabel) + '</div>' +
        '</td>' +
        '<td>' + formatDate(new Date(r.completionDateConfirmed + "T00:00:00"), lang) + '</td>' +
        '<td><button class="btn btn-secondary" data-ref="' + escapeHtml(r.referenceNo) + '">' + t("printingJobs.markReady") + '</button></td>' +
        '</tr>';
    }).join("");

    tbody.querySelectorAll("tr[data-ref]").forEach(function (tr) {
      tr.style.cursor = "pointer";
      tr.title = t("printingJobs.clickForDetail");
      tr.addEventListener("click", function (e) {
        if (e.target.closest("button")) return;
        window.location.href = "/officer/request-detail?ref=" + encodeURIComponent(this.getAttribute("data-ref")) + "&from=printing";
      });
    });

    tbody.querySelectorAll("button[data-ref]").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const ref = this.getAttribute("data-ref");
        const record = records.find(function (r) { return r.referenceNo === ref; });
        if (!record) return;

        // Fetched at click time (not with the page) so a place the admin
        // just added or archived is reflected immediately.
        const pickupOptions = await loadPickupOptions();
        const defaultPickup = pickupOptions.find(function (p) { return p.isDefault; }) || pickupOptions[0];

        showConfirmModal({
          title: t("printingJobs.confirmReady.title"),
          message: "",
          confirmText: t("printingJobs.confirmReady.confirmBtn"),
          build: function (container) { return buildReadyFields(container, pickupOptions, defaultPickup, lang, record); },
          onConfirm: async function (chosen) {
            showProcessing();
            try {
              const res = await fetch("/api/requests/" + encodeURIComponent(ref) + "/ready", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(chosen || {})
              });
              if (!res.ok) {
                showResultModal({
                  success: false,
                  title: t("printingJobs.readyErrorTitle"),
                  message: t("printingJobs.readyError")
                });
              } else {
                showActionResult(true, t("printingJobs.readySuccess").replace("{ref}", ref));
              }
              renderPrintingJobs();
            } catch (err) {
              showActionResult(false, t("result.network"));
            } finally {
              hideProcessing();
            }
          }
        });
      });
    });
  }

  document.addEventListener("odprs:langchange", renderPrintingJobs);
  renderPrintingJobs();
</script>
</body>
</html>
