<%- include("../partials/head", { title: "ผลการประเมินความพึงพอใจ | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.evaluations", crumbFallback: "ผลประเมินความพึงพอใจ / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="evalReport.title">ผลประเมินความพึงพอใจ</h1>
    <p class="page-subtitle" data-i18n="evalReport.subtitle">ภาพรวมคะแนนความพึงพอใจและความคิดเห็นจากผู้ขอ หลังได้รับเอกสารเรียบร้อยแล้ว</p>

    <div class="tab-row">
      <div class="tab-nav" id="tab-nav">
        <div class="tab-nav-thumb" id="tab-nav-thumb"></div>
        <button type="button" class="tab-btn active" id="tab-btn-overview" data-tab="overview" data-i18n="evalReport.tab.overview">ภาพรวม</button>
        <button type="button" class="tab-btn" id="tab-btn-list" data-tab="list" data-i18n="evalReport.tab.list">ค้นหา / รายการทั้งหมด</button>
      </div>
      <div class="tab-row-actions">
        <select id="eval-year-filter" class="toolbar-select"></select>
        <button type="button" class="export-btn" id="eval-export-btn">
          <span class="icon" data-icon="download"><%- icon('download') %></span>
          <span class="export-btn-label" data-i18n="export.excel">ส่งออก Excel</span>
        </button>
      </div>
    </div>

    <div id="tab-panel-overview">
      <!-- Row 1: headline (core question) + the three counts -->
      <div class="er-top">
        <div class="card er-hero" id="er-hero"></div>
        <div class="card er-kpis">
          <div class="er-kpi">
            <span class="er-kpi-label" data-i18n="evalReport.kpi.totalEvaluated">จำนวนที่ได้รับการประเมิน</span>
            <span class="er-kpi-value" id="kpi-total-evaluated">—</span>
          </div>
          <div class="er-kpi">
            <span class="er-kpi-label" data-i18n="evalReport.kpi.totalCompleted">จำนวนคำขอที่เสร็จสมบูรณ์</span>
            <span class="er-kpi-value" id="kpi-total-completed">—</span>
          </div>
          <div class="er-kpi">
            <span class="er-kpi-label" data-i18n="evalReport.kpi.totalWithComments">จำนวนที่มีความคิดเห็น</span>
            <span class="er-kpi-value" id="kpi-total-with-comments">—</span>
          </div>
        </div>
      </div>

      <!-- Row 2: every question of the form, grouped by section -->
      <div class="card er-results">
        <div class="card-header"><span data-i18n="evalReport.resultsTitle">ผลการประเมินแยกตามหัวข้อ</span></div>
        <div class="card-body">
          <div id="scores-grid"></div>
        </div>
      </div>

      <div class="card feed-card">
        <div class="card-header feed-card-header">
          <div>
            <div class="feed-title" data-i18n="evalReport.commentsTitle">ความคิดเห็นล่าสุด</div>
            <div class="feed-subtitle" id="comments-feed-subtitle"></div>
          </div>
          <div class="trend-view-switch" id="comments-sort-switch" role="tablist">
            <button type="button" class="trend-view-btn active" data-sort="recent" role="tab" aria-selected="true">
              <span class="icon" data-icon="clock"><%- icon('clock') %></span>
              <span data-i18n="evalReport.feedSort.recent">ล่าสุด</span>
            </button>
            <button type="button" class="trend-view-btn" data-sort="lowest" role="tab" aria-selected="false">
              <span class="icon" data-icon="alert-triangle"><%- icon('alert-triangle') %></span>
              <span data-i18n="evalReport.feedSort.lowest">คะแนนต่ำก่อน</span>
            </button>
          </div>
        </div>
        <div class="feed-list" id="comments-feed"></div>
        <div class="feed-footer">
          <button type="button" class="feed-more-btn" id="view-all-comments-btn">
            <span data-i18n="evalReport.viewAllComments">ดูความคิดเห็นทั้งหมด</span>
            <span class="feed-more-arrow" aria-hidden="true">›</span>
          </button>
        </div>
      </div>
    </div>

    <div id="tab-panel-list" hidden>
      <div class="card filter-panel">
        <div class="card-body">
          <div class="filter-top">
            <div class="filter-search">
              <span class="icon filter-search-icon" data-icon="search"><%- icon('search') %></span>
              <input type="text" id="eval-search-input" data-i18n-placeholder="evalReport.searchPlaceholder"
                     placeholder="เลขอ้างอิง, ชื่อผู้ขอ, หรือคำในความคิดเห็น">
            </div>
            <button type="button" class="btn btn-secondary filter-toggle" id="eval-filter-toggle" aria-expanded="false" aria-controls="eval-filter-body">
              <span data-i18n="filter.toggle">ตัวกรอง</span>
              <span class="filter-toggle-count" id="eval-filter-count" hidden></span>
              <span class="icon filter-toggle-chevron" data-icon="chevron-down"><%- icon('chevron-down') %></span>
            </button>
          </div>

          <!-- Filters slide open/closed under the search (filterPanel in the script). -->
          <div class="filter-collapse" id="eval-filter-body">
          <div class="filter-collapse-inner">
          <div class="filter-row">
            <div class="filter-group">
              <div class="filter-head">
                <span class="filter-label" data-i18n="dashboard.filter.period">ช่วงเวลา</span>
                <label class="filter-switch">
                  <input type="checkbox" id="eval-range-toggle">
                  <span data-i18n="dashboard.dateMode.custom">กำหนดช่วงวันที่เอง</span>
                </label>
              </div>
              <div id="eval-month-fields" class="filter-controls">
                <select id="eval-month-filter" class="toolbar-select"></select>
              </div>
              <div id="eval-range-fields" class="filter-controls" hidden>
                <input type="date" id="eval-from-date" class="toolbar-select" aria-label="From">
                <span class="filter-to" data-i18n="dashboard.dateMode.rangeTo">ถึง</span>
                <input type="date" id="eval-to-date" class="toolbar-select" aria-label="To">
                <button type="button" id="eval-range-clear" class="filter-clear" data-i18n="dashboard.dateMode.clear">ล้าง</button>
              </div>
            </div>

            <div class="filter-group">
              <div class="filter-head"><span class="filter-label" data-i18n="evalReport.sortFilter">เรียงตาม</span></div>
              <div class="filter-controls">
                <select id="eval-sort-filter" class="toolbar-select">
                  <option value="recent" data-i18n="evalReport.sortFilter.recent">ล่าสุดก่อน</option>
                  <option value="lowest" data-i18n="evalReport.sortFilter.lowest">คะแนนต่ำไปสูง</option>
                </select>
              </div>
            </div>

            <div class="filter-group">
              <div class="filter-head"><span class="filter-label" data-i18n="filter.show">แสดง</span></div>
              <div class="filter-controls">
                <label class="filter-chip">
                  <input type="checkbox" id="eval-has-comment-filter">
                  <span data-i18n="evalReport.hasCommentFilter">เฉพาะที่มีความเห็น</span>
                </label>
              </div>
            </div>
          </div>
          </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <span id="eval-result-count"></span>
          <label style="display:flex; align-items:center; gap:8px; font-weight:400; font-size:13px;">
            <span data-i18n="evalReport.rowsPerPage">แสดงต่อหน้า</span>
            <select id="eval-page-size-select" style="padding:6px 10px; border:1px solid var(--color-border); border-radius:8px; font-family:var(--font-family); font-size:13px;">
              <option value="10">10</option>
              <option value="20" selected>20</option>
              <option value="50">50</option>
            </select>
          </label>
        </div>
        <div class="card-body" style="padding:0;">
          <table class="data-table">
            <thead>
              <tr>
                <th data-i18n="evalReport.th.ref">เลขอ้างอิง / RUN NUMBER</th>
                <th data-i18n="evalReport.th.requester">ผู้ขอ</th>
                <th data-i18n="evalReport.th.item">รายการ</th>
                <th data-i18n="evalReport.th.officer">พนักงานที่รับผิดชอบ</th>
                <th data-i18n="evalReport.th.overall">คะแนนโดยรวม</th>
                <th data-i18n="evalReport.th.comment">ความคิดเห็น</th>
                <th data-i18n="evalReport.th.submitted">วันที่ประเมิน</th>
              </tr>
            </thead>
            <tbody id="eval-body"></tbody>
          </table>
        </div>
        <div class="card-body" style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid var(--color-border);">
          <span id="eval-page-info" style="font-size:13px; color:var(--color-muted);"></span>
          <div style="display:flex; gap:8px;">
            <button class="btn btn-secondary" id="eval-prev-page-btn" data-i18n="evalReport.prevPage">‹ ก่อนหน้า</button>
            <button class="btn btn-secondary" id="eval-next-page-btn" data-i18n="evalReport.nextPage">ถัดไป ›</button>
          </div>
        </div>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  // Same server-side aggregation/pagination philosophy as dashboard.ejs and
  // history.ejs — the browser only ever handles a KPI summary object or one
  // page's worth of feedback rows, never every evaluation row at once.
  // The questions come from the admin's form (/admin/evaluation-form), so
  // everything below is built from the summary/records the API returns.
  function pick(th, en) { return getLang() === "en" && en ? en : th; }
  function fmtAvg(v) { return v == null ? "—" : Number(v).toFixed(1); }
  // Each evaluation's score: the average of its 1-5 answers.
  function coreOf(r) { return r.averageRating; }
  function fmtScore(v) { return v == null ? "—" : (Number.isInteger(v) ? String(v) : Number(v).toFixed(1)); }

  // Green/amber/red tiers on the score bar give an at-a-glance read on which
  // dimensions need attention, without requiring the officer to compare raw
  // numbers across five cards.
  function scoreTier(value) {
    if (value >= 4) return "score-tier-good";
    if (value >= 3) return "score-tier-mid";
    return "score-tier-low";
  }

  const yearFilter = document.getElementById("eval-year-filter");
  const monthFilter = document.getElementById("eval-month-filter");
  const sortFilter = document.getElementById("eval-sort-filter");
  const searchInput = document.getElementById("eval-search-input");
  const hasCommentFilter = document.getElementById("eval-has-comment-filter");
  const pageSizeSelect = document.getElementById("eval-page-size-select");
  const prevPageBtn = document.getElementById("eval-prev-page-btn");
  const nextPageBtn = document.getElementById("eval-next-page-btn");

  let summary = null;
  let commentsFeedRecords = [];
  let currentPage = 1;
  let requestSeq = 0; // guards against an older, slower fetch overwriting a newer one's result

  function debounce(fn, delay) {
    let timer;
    return function () {
      const args = arguments;
      const self = this;
      clearTimeout(timer);
      timer = setTimeout(function () { fn.apply(self, args); }, delay);
    };
  }

  function formatNumber(n) {
    return n.toLocaleString(getLang() === "en" ? "en-US" : "th-TH");
  }

  function renderYearFilterOptions() {
    const lang = getLang();
    const previous = yearFilter.value;
    yearFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("evalReport.yearFilter.all");
    yearFilter.appendChild(allOpt);

    (summary.availableYears || []).forEach(function (year) {
      const opt = document.createElement("option");
      opt.value = String(year);
      opt.textContent = lang === "en" ? String(year) : String(year + 543);
      yearFilter.appendChild(opt);
    });

    yearFilter.value = previous;
  }

  function renderMonthFilterOptions() {
    const lang = getLang();
    const previous = monthFilter.value;
    monthFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("evalReport.monthFilter.all");
    monthFilter.appendChild(allOpt);

    const months = lang === "en" ? ENG_MONTHS : THAI_MONTHS;
    months.forEach(function (label, index) {
      const opt = document.createElement("option");
      opt.value = String(index);
      opt.textContent = label;
      monthFilter.appendChild(opt);
    });

    monthFilter.value = previous;
  }

  function renderKpis() {
    document.getElementById("kpi-total-evaluated").textContent = formatNumber(summary.totalEvaluated);
    document.getElementById("kpi-total-completed").textContent = formatNumber(summary.totalCompleted);
    document.getElementById("kpi-total-with-comments").textContent = formatNumber(summary.totalWithComments);
  }

  // Plain-words label for a 1-5 average, matching the colour tiers.
  function tierLabel(v) {
    if (v >= 4.5) return t("evalReport.tier.excellent");
    if (v >= 4) return t("evalReport.tier.good");
    if (v >= 3) return t("evalReport.tier.fair");
    return t("evalReport.tier.low");
  }

  function starsHtml(v) {
    let html = "";
    for (let i = 1; i <= 5; i++) {
      const fill = Math.max(0, Math.min(1, v - (i - 1)));
      html += '<span class="er-star"><span class="er-star-fill" style="width:' + Math.round(fill * 100) + '%">★</span>★</span>';
    }
    return html;
  }

  // Headline card: average satisfaction of the period (each respondent's own
  // average, averaged), with the spread of every 1-5 answer given.
  function renderHero() {
    const box = document.getElementById("er-hero");
    const core = summary.overall;
    if (!core || !core.count) {
      box.innerHTML = '<div class="card-body er-hero-empty">' +
        '<div class="er-hero-label">' + escapeHtml(t("evalReport.overallTitle")) + '</div>' +
        '<div class="empty-state">' + escapeHtml(t("evalReport.noData")) + '</div></div>';
      return;
    }
    const spread = core.spread || [0, 0, 0, 0, 0];
    const answers = spread.reduce(function (a, b) { return a + b; }, 0);
    const bars = [5, 4, 3, 2, 1].map(function (n) {
      const c = spread[n - 1];
      const pct = answers ? Math.round((c / answers) * 100) : 0;
      return '<div class="er-dist-row">' +
        '<span class="er-dist-n">' + n + ' ★</span>' +
        '<span class="er-dist-track"><span class="er-dist-fill er-dist-' + n + '" style="width:' + pct + '%"></span></span>' +
        '<span class="er-dist-num">' + pct + '%</span>' +
        '</div>';
    }).join("");
    box.innerHTML = '<div class="card-body er-hero-body">' +
      '<div class="er-hero-score ' + scoreTier(core.average) + '">' +
        '<div class="er-hero-label">' + escapeHtml(t("evalReport.overallTitle")) + '</div>' +
        '<div class="er-hero-num">' + core.average.toFixed(1) + '<span class="er-hero-of">/ 5</span></div>' +
        '<div class="er-stars" aria-hidden="true">' + starsHtml(core.average) + '</div>' +
        '<div class="er-hero-tier"><span class="er-tier-pill">' + escapeHtml(tierLabel(core.average)) + '</span>' +
          '<span>' + escapeHtml(t("evalReport.peopleCount").replace("{n}", formatNumber(core.count))) + '</span></div>' +
      '</div>' +
      '<div class="er-dist">' + bars + '</div>' +
      '</div>';
  }

  // "120 of 300 people", plus when the question was added or removed during
  // the period (so a smaller count isn't mistaken for low interest).
  // Only shown when it tells something: when not everyone answered this
  // question (optional, or added/removed during the period). A question
  // everybody answered gets no extra line, so the list stays clean.
  function reachLine(q) {
    const lang = getLang();
    const everyone = q.count >= summary.totalEvaluated && !q.addedAt && !q.removedAt;
    if (everyone) return "";
    const parts = ['<span>' + escapeHtml(t("evalReport.reach").replace("{n}", formatNumber(q.count)).replace("{total}", formatNumber(summary.totalEvaluated))) + '</span>'];
    if (q.addedAt) parts.push('<span class="er-change">' + escapeHtml(t("evalReport.addedOn").replace("{date}", lang === "en" ? formatDateEn(new Date(q.addedAt)) : formatDateThai(new Date(q.addedAt)))) + '</span>');
    if (q.removedAt) parts.push('<span class="er-change">' + escapeHtml(t("evalReport.removedOn").replace("{date}", lang === "en" ? formatDateEn(new Date(q.removedAt)) : formatDateThai(new Date(q.removedAt)))) + '</span>');
    return '<span class="er-row-count">' + parts.join("") + '</span>';
  }

  // One row per rating question: label | stacked bar | average. The bar is
  // the whole group of people who answered, split 1 → 5 from left to right
  // (red, gray, blue); each part's width is its share. Hovering a part names it.
  function likertSegment(n, c, total) {
    if (!total || !c) return "";
    const share = c / total;
    const pct = Math.round(share * 100);
    const tip = t("evalReport.likert." + n) + ": " + t("evalReport.likertTip").replace("{n}", formatNumber(c)).replace("{pct}", pct);
    return '<span class="lk lk-' + n + '" style="flex-grow:' + c + '" title="' + escapeHtml(tip) + '"></span>';
  }
  function likertBar(q) {
    const sp = q.spread || [0, 0, 0, 0, 0];
    const total = sp.reduce(function (a, b) { return a + b; }, 0);
    const happy = total ? Math.round(((sp[3] + sp[4]) / total) * 100) : 0;
    const label = t("evalReport.likertAria").replace("{pct}", happy);
    return '<div class="er-likert" role="img" aria-label="' + escapeHtml(label) + '">' +
      [1, 2, 3, 4, 5].map(function (n) { return likertSegment(n, sp[n - 1], total); }).join("") +
      '</div>';
  }

  function ratingRow(q) {
    return '<div class="er-row">' +
      '<div class="er-row-label">' + escapeHtml(pick(q.textTh, q.textEn)) + reachLine(q) + '</div>' +
      likertBar(q) +
      '<div class="er-row-score">' + (q.count ? q.average.toFixed(1) : "—") + '</div>' +
      '</div>';
  }

  // Legend + side captions, once above all rating rows.
  function likertLegend() {
    const items = [1, 2, 3, 4, 5].map(function (n) {
      return '<span class="er-legend-item"><span class="lk-swatch lk-' + n + '"></span>' + escapeHtml(n + " " + t("evalReport.likert." + n)) + '</span>';
    }).join("");
    return '<div class="er-likert-head">' +
      '<div class="er-legend">' + items + '</div>' +
      '<div class="er-row er-row-captions"><span></span>' +
        '<div class="er-likert-captions"><span>' + escapeHtml(t("evalReport.likertLow")) + '</span><span>' + escapeHtml(t("evalReport.likertHigh")) + '</span></div>' +
        '<span class="er-row-score-cap">' + escapeHtml(t("evalReport.avgShort")) + '</span>' +
      '</div>' +
    '</div>';
  }

  // Single/multi: one bar per choice, against the number of people who
  // answered the question (multi can add up to more than 100%).
  function choiceBlock(q) {
    const total = q.count || 0;
    const rows = (q.options || []).map(function (o) {
      const pct = total ? Math.round((o.count / total) * 100) : 0;
      return '<div class="er-opt">' +
        '<span class="er-opt-label">' + escapeHtml(pick(o.th, o.en)) + (o.removed ? ' <span class="er-removed">' + escapeHtml(t("evalReport.removedOption")) + '</span>' : "") + '</span>' +
        '<span class="er-opt-track"><span class="er-opt-fill" style="width:' + pct + '%"></span></span>' +
        '<span class="er-opt-num">' + formatNumber(o.count) + ' <small>(' + pct + '%)</small></span>' +
        '</div>';
    }).join("");
    return '<div class="er-block">' +
      '<div class="er-block-head"><span class="er-block-title">' + escapeHtml(pick(q.textTh, q.textEn)) + '</span>' +
      '<span class="er-block-meta"><span class="er-type-pill">' + escapeHtml(t("evalForm.type." + q.type)) + '</span>' + reachLine(q) + '</span></div>' +
      rows + '</div>';
  }

  function textBlock(q) {
    return '<div class="er-block er-block-text">' +
      '<div><span class="er-block-title">' + escapeHtml(pick(q.textTh, q.textEn)) + '</span>' +
      '<span class="er-block-meta">' + reachLine(q) + '</span></div>' +
      (q.count ? '<button type="button" class="er-read-btn" data-read-comments>' + escapeHtml(t("evalReport.readAnswers")) + ' ›</button>' : "") +
      '</div>';
  }

  function sectionResults(title, questions) {
    const ratings = questions.filter(function (q) { return q.type === "rating"; });
    const others = questions.filter(function (q) { return q.type !== "rating"; });
    return '<section class="er-section">' +
      (title ? '<h3 class="er-section-title">' + escapeHtml(title) + '</h3>' : "") +
      (ratings.length ? '<div class="er-rows">' + ratings.map(ratingRow).join("") + '</div>' : "") +
      others.map(function (q) { return q.type === "text" ? textBlock(q) : choiceBlock(q); }).join("") +
      '</section>';
  }

  function renderScoresGrid() {
    renderHero();
    const container = document.getElementById("scores-grid");

    if (summary.totalEvaluated === 0) {
      container.innerHTML = '<div class="empty-state">' + t("evalReport.noData") + '</div>';
      return;
    }

    const anyRating = (summary.sections || []).some(function (sec) { return sec.questions.some(function (q) { return q.type === "rating"; }); });
    let html = (anyRating ? likertLegend() : "") + (summary.sections || []).filter(function (sec) { return sec.questions.length; }).map(function (sec) {
      return sectionResults(pick(sec.titleTh, sec.titleEn), sec.questions);
    }).join("");
    // Questions deleted from the form but answered in this period.
    if ((summary.removed || []).length) {
      html += '<details class="er-removed-group"><summary>' + escapeHtml(t("evalReport.removedQuestions").replace("{n}", summary.removed.length)) + '</summary>' +
        sectionResults("", summary.removed.map(function (q) {
          return Object.assign({}, q, { textTh: q.sectionTitleTh + " › " + q.textTh, textEn: (q.sectionTitleEn || q.sectionTitleTh) + " › " + (q.textEn || q.textTh) });
        })) + '</details>';
    }
    container.innerHTML = html || '<div class="empty-state">' + t("evalReport.noData") + '</div>';
    applyIcons();
  }

  async function fetchSummary() {
    const params = new URLSearchParams();
    if (yearFilter.value) params.set("year", yearFilter.value);
    const res = await fetch("/api/evaluations-summary?" + params.toString());
    summary = await res.json();
  }

  // "Latest comments" feed: the 10 newest evaluations that have a comment,
  // with a switch to the 10 lowest-rated instead when hunting for problems.
  const COMMENTS_FEED_SIZE = 10;
  let commentsFeedSort = "recent";

  async function loadCommentsFeed() {
    const params = new URLSearchParams();
    if (yearFilter.value) params.set("year", yearFilter.value);
    params.set("hasComment", "1");
    if (commentsFeedSort === "lowest") params.set("sort", "lowest");
    params.set("page", "1");
    params.set("pageSize", String(COMMENTS_FEED_SIZE));
    const res = await fetch("/api/evaluations?" + params.toString());
    const data = await res.json();
    commentsFeedRecords = data.records;
    renderCommentsFeed(commentsFeedRecords);
  }

  function relativeDay(date) {
    const lang = getLang();
    const startOf = function (d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()); };
    const days = Math.round((startOf(new Date()) - startOf(date)) / 86400000);
    if (days <= 0) return t("evalReport.feed.today");
    if (days === 1) return t("evalReport.feed.yesterday");
    if (days < 30) return t("evalReport.feed.daysAgo").replace("{n}", days);
    return lang === "en" ? formatDateEn(date) : formatDateThai(date);
  }

  function initialOf(name) {
    const trimmed = String(name || "").replace(/^(นาย|นางสาว|นาง|ดร\.|ผศ\.|รศ\.|ศ\.|อ\.)\s*/, "").trim();
    return trimmed ? trimmed.charAt(0).toUpperCase() : "?";
  }

  function renderCommentsFeed(records) {
    const lang = getLang();
    const container = document.getElementById("comments-feed");
    document.getElementById("comments-feed-subtitle").textContent =
      t(commentsFeedSort === "lowest" ? "evalReport.feed.subtitleLowest" : "evalReport.feed.subtitleRecent").replace("{n}", COMMENTS_FEED_SIZE);

    if (records.length === 0) {
      container.innerHTML = '<div class="empty-state">' + t("evalReport.commentsFeedEmpty") + '</div>';
      return;
    }

    container.innerHTML = records.map(function (r) {
      const idLabel = r.runNumber ? (r.runNumber + " / " + r.referenceNo) : r.referenceNo;
      const submitted = new Date(r.submittedAt);
      // Only the sub-scores that were rated low (1-3) — the ones that explain
      // the comment. A clean 4-5 across the board shows no chips at all.
      const lowDims = (r.ratings || []).filter(function (a) { return a.rating <= 3; }).map(function (a) {
        return '<span class="feed-dim ' + scoreTier(a.rating) + '">' + escapeHtml(pick(a.th, a.en)) +
          ' <strong>' + a.rating + '/5</strong></span>';
      }).join("");

      return '<article class="feed-item">' +
        '<div class="feed-avatar" aria-hidden="true">' + escapeHtml(initialOf(r.requesterName)) + '</div>' +
        '<div class="feed-main">' +
          '<div class="feed-meta">' +
            '<span class="feed-name">' + escapeHtml(r.requesterName) + '</span>' +
            '<span class="feed-when" title="' + escapeHtml(formatDateTime(submitted, lang)) + '">' +
              '<span class="icon">' + ICONS.clock + '</span>' + escapeHtml(relativeDay(submitted)) +
            '</span>' +
          '</div>' +
          '<p class="feed-text">' + escapeHtml(r.comment) + '</p>' +
          '<div class="feed-foot">' +
            '<span class="feed-ref">' + escapeHtml(idLabel) + '</span>' +
            lowDims +
          '</div>' +
        '</div>' +
        '<div class="feed-score ' + scoreTier(coreOf(r) || 0) + '" title="' + escapeHtml(t("evalReport.th.overall")) + '">' +
          '<span class="feed-score-star">★</span>' +
          '<span class="feed-score-num">' + fmtScore(coreOf(r)) + '</span>' +
          '<span class="feed-score-max">/5</span>' +
        '</div>' +
      '</article>';
    }).join("");
  }

  document.getElementById("comments-sort-switch").addEventListener("click", function (e) {
    const btn = e.target.closest("[data-sort]");
    if (!btn || btn.getAttribute("data-sort") === commentsFeedSort) return;
    commentsFeedSort = btn.getAttribute("data-sort");
    this.querySelectorAll("[data-sort]").forEach(function (b) {
      const on = b === btn;
      b.classList.toggle("active", on);
      b.setAttribute("aria-selected", on ? "true" : "false");
    });
    loadCommentsFeed();
  });

  async function reloadSummary() {
    await fetchSummary();
    renderYearFilterOptions();
    renderKpis();
    renderScoresGrid();
    await loadCommentsFeed();
  }

  async function renderTable() {
    const lang = getLang();
    const pageSize = Number(pageSizeSelect.value);

    const params = new URLSearchParams();
    addPeriodParams(params);
    if (searchInput.value.trim()) params.set("q", searchInput.value.trim());
    if (hasCommentFilter.checked) params.set("hasComment", "1");
    if (sortFilter.value === "lowest") params.set("sort", "lowest");
    params.set("page", currentPage);
    params.set("pageSize", pageSize);

    const seq = ++requestSeq;
    const res = await fetch("/api/evaluations?" + params.toString());
    const data = await res.json();
    if (seq !== requestSeq) return; // a newer request has already landed

    const total = data.total;
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > totalPages) { currentPage = totalPages; return renderTable(); }

    const startIdx = (currentPage - 1) * pageSize;
    const from = total === 0 ? 0 : startIdx + 1;
    const to = Math.min(startIdx + pageSize, total);

    document.getElementById("eval-result-count").textContent = t("evalReport.resultCount")
      .replace("{from}", from).replace("{to}", to).replace("{total}", total);
    document.getElementById("eval-page-info").textContent = t("evalReport.pageInfo")
      .replace("{page}", currentPage).replace("{pages}", totalPages);
    prevPageBtn.disabled = currentPage <= 1;
    nextPageBtn.disabled = currentPage >= totalPages;

    const tbody = document.getElementById("eval-body");

    if (data.records.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="empty-state">' + t("evalReport.empty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = data.records.map(function (r) {
      const idLabel = r.runNumber ? (r.runNumber + " / " + r.referenceNo) : r.referenceNo;
      const breakdown = (r.ratings || []).map(function (a) {
        return pick(a.th, a.en) + ": " + a.rating;
      }).concat(r.averageRating != null ? [t("evalReport.avgAll") + ": " + fmtAvg(r.averageRating)] : []).join("\n");
      // Requester-typed text — escaped before it goes into innerHTML.
      const comment = r.comment ? escapeHtml(r.comment) : ('<span class="hint">' + t("evalReport.noComment") + '</span>');
      const officerLabel = escapeHtml(r.officerName || "—");

      return '<tr>' +
        '<td>' + escapeHtml(idLabel) + '</td>' +
        '<td>' + escapeHtml(r.requesterName) + '</td>' +
        '<td>' + escapeHtml(r.itemList) + '</td>' +
        '<td>' + officerLabel + '</td>' +
        '<td title="' + escapeHtml(breakdown) + '"><span class="er-cell-score ' + scoreTier(coreOf(r) || 0) + '">' + fmtScore(coreOf(r)) + '</span> <span class="hint">/ 5</span></td>' +
        '<td>' + comment + '</td>' +
        '<td>' + formatDateTime(new Date(r.submittedAt), lang) + '</td>' +
        '</tr>';
    }).join("");
  }

  function onFilterChange() {
    currentPage = 1;
    renderTable();
  }

  // Period for the list and the Excel export: a custom from/to range when
  // the switch is on (then the year above and the month are ignored),
  // otherwise the year above + month.
  const rangeToggle = document.getElementById("eval-range-toggle");
  const fromDateInput = document.getElementById("eval-from-date");
  const toDateInput = document.getElementById("eval-to-date");
  function addPeriodParams(params) {
    if (rangeToggle.checked && (fromDateInput.value || toDateInput.value)) {
      if (fromDateInput.value) params.set("fromDate", fromDateInput.value);
      if (toDateInput.value) params.set("toDate", toDateInput.value);
      return;
    }
    if (yearFilter.value) params.set("year", yearFilter.value);
    if (monthFilter.value !== "") params.set("month", monthFilter.value);
  }
  function onRangeToggle() {
    document.getElementById("eval-month-fields").hidden = rangeToggle.checked;
    document.getElementById("eval-range-fields").hidden = !rangeToggle.checked;
    onFilterChange();
  }
  rangeToggle.addEventListener("change", onRangeToggle);

  // ---- collapsible filter panel ----
  // Closed by default; the button shows how many filters are on so a closed
  // panel never hides the fact that the list is filtered.
  const filterPanel = initFilterCollapse({
    toggle: "eval-filter-toggle", body: "eval-filter-body", badge: "eval-filter-count", key: "evaluations",
    count: function () {
      let n = 0;
      if (rangeToggle.checked ? (fromDateInput.value || toDateInput.value) : monthFilter.value !== "") n++;
      if (sortFilter.value !== "recent") n++;
      if (hasCommentFilter.checked) n++;
      return n;
    }
  });
  function syncFilterCount() { filterPanel.sync(); }
  fromDateInput.addEventListener("change", function () {
    if (toDateInput.value && fromDateInput.value > toDateInput.value) toDateInput.value = fromDateInput.value;
    toDateInput.min = fromDateInput.value;
    onFilterChange();
  });
  toDateInput.addEventListener("change", onFilterChange);
  document.getElementById("eval-range-clear").addEventListener("click", function () {
    fromDateInput.value = "";
    toDateInput.value = "";
    toDateInput.min = "";
    rangeToggle.checked = false;
    onRangeToggle();
  });

  async function onYearChange() {
    currentPage = 1;
    await reloadSummary();
    renderTable();
  }

  const onSearchInput = debounce(onFilterChange, 300);

  // Summary sheet follows the year filter; the list sheet follows the
  // search / month / sort / comment filters on the list tab.
  document.getElementById("eval-export-btn").addEventListener("click", function () {
    const params = new URLSearchParams();
    addPeriodParams(params);
    if (searchInput.value.trim()) params.set("q", searchInput.value.trim());
    if (hasCommentFilter.checked) params.set("hasComment", "1");
    if (sortFilter.value === "lowest") params.set("sort", "lowest");
    downloadReport("/api/reports/evaluations.xlsx?" + params.toString(), this);
  });

  yearFilter.addEventListener("change", onYearChange);
  monthFilter.addEventListener("change", onFilterChange);
  sortFilter.addEventListener("change", onFilterChange);
  searchInput.addEventListener("input", onSearchInput);
  hasCommentFilter.addEventListener("change", onFilterChange);
  pageSizeSelect.addEventListener("change", onFilterChange);

  prevPageBtn.addEventListener("click", function () {
    currentPage -= 1;
    renderTable();
  });
  nextPageBtn.addEventListener("click", function () {
    currentPage += 1;
    renderTable();
  });

  document.addEventListener("odprs:langchange", function () {
    // The page's own first load may not have arrived yet.
    if (!summary) { renderMonthFilterOptions(); positionTabThumb(true); return; }
    renderYearFilterOptions();
    renderMonthFilterOptions();
    renderKpis();
    renderScoresGrid();
    renderCommentsFeed(commentsFeedRecords);
    renderTable();
    positionTabThumb(true); // label width changes with language, snap without a slide
  });

  // Both tabs' data load up front regardless of which is visible — each
  // fetch is already small (a summary object, or one page of feedback rows)
  // so there's no real cost to having it ready before the officer switches.
  const tabButtons = document.querySelectorAll(".tab-btn");
  const tabThumb = document.getElementById("tab-nav-thumb");
  const tabPanels = {
    overview: document.getElementById("tab-panel-overview"),
    list: document.getElementById("tab-panel-list")
  };

  // Slides/resizes the thumb to sit behind whichever button is active — the
  // two labels are different lengths, so this reads real layout (offsetLeft/
  // offsetWidth) each time rather than assuming a fixed thumb width.
  function positionTabThumb(skipAnimation) {
    const activeBtn = document.querySelector(".tab-btn.active");
    if (!activeBtn) return;
    if (skipAnimation) tabThumb.style.transition = "none";
    tabThumb.style.left = activeBtn.offsetLeft + "px";
    tabThumb.style.width = activeBtn.offsetWidth + "px";
    if (skipAnimation) {
      void tabThumb.offsetWidth; // force reflow before restoring the transition
      tabThumb.style.transition = "";
    }
  }

  function activateTab(name, skipAnimation) {
    if (!tabPanels[name]) name = "overview";
    tabButtons.forEach(function (btn) {
      btn.classList.toggle("active", btn.getAttribute("data-tab") === name);
    });
    Object.keys(tabPanels).forEach(function (key) {
      tabPanels[key].hidden = key !== name;
    });
    positionTabThumb(skipAnimation);
    history.replaceState(null, "", "#" + name);
  }

  tabButtons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      activateTab(btn.getAttribute("data-tab"));
    });
  });

  activateTab(window.location.hash.replace("#", "") || "overview", true);

  document.getElementById("scores-grid").addEventListener("click", function (e) {
    if (!e.target.closest("[data-read-comments]")) return;
    hasCommentFilter.checked = true;
    syncFilterCount();
    activateTab("list");
    onFilterChange();
  });

  document.getElementById("view-all-comments-btn").addEventListener("click", function () {
    hasCommentFilter.checked = true;
    sortFilter.value = commentsFeedSort; // carry the feed's current order over
    syncFilterCount();
    activateTab("list");
    onFilterChange();
  });

  renderMonthFilterOptions();
  reloadSummary().then(renderTable);
</script>
</body>
</html>
