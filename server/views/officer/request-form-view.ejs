<%- include("../partials/head", { title: "ใบคำขอพิมพ์เอกสาร | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "requestForm.crumb", crumbFallback: "ใบคำขอพิมพ์เอกสาร" }) %>

  <main class="app-main">

    <div id="not-found" style="display:none;">
      <h1 class="page-title" data-i18n="detail.notFound">ไม่พบคำขอนี้</h1>
      <a class="btn btn-secondary" href="/officer/history" data-i18n="requestForm.backToHistory">กลับไปที่ประวัติคำขอ</a>
    </div>

    <div id="form-content" style="display:none;">
      <div class="no-print" style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:20px;">
        <div>
          <h1 class="page-title" style="margin-bottom:4px;" id="f-title">—</h1>
          <p class="page-subtitle" style="margin:0;" data-i18n="requestForm.subtitle">ใบคำขอพิมพ์เอกสารฉบับเต็ม สำหรับตรวจสอบหรือพิมพ์ซ้ำ</p>
        </div>
        <div style="display:flex; gap:10px;">
          <a class="btn btn-secondary" href="/officer/request-form-view/pdf?ref=<%= encodeURIComponent(ref) %>" target="_blank">
            <span class="icon" data-icon="download"><%- icon('download') %></span>
            <span data-i18n="submitted.downloadPdfBtn">ดาวน์โหลด PDF</span>
          </a>
          <button class="btn btn-primary" onclick="window.print()">
            <span class="icon" data-icon="printer"><%- icon('printer') %></span>
            <span data-i18n="submitted.printBtn">พิมพ์ใบคำขอ</span>
          </button>
        </div>
      </div>

      <div class="card">
        <div class="card-body print-doc">
          <%- include("../partials/print-form") %>
        </div>
      </div>

      <div class="form-actions no-print">
        <a class="btn btn-secondary" href="/officer/history" data-i18n="requestForm.backToHistory">กลับไปที่ประวัติคำขอ</a>
      </div>
    </div>

  </main>

<%- include("../partials/foot") %>
<script>
  const refNo = new URLSearchParams(window.location.search).get("ref");
  let record = null;

  async function fetchRecord() {
    if (!refNo) { record = null; return; }
    const res = await fetch("/api/requests/" + encodeURIComponent(refNo));
    record = res.ok ? await res.json() : null;
  }

  function render() {
    if (!record) {
      document.getElementById("not-found").style.display = "block";
      document.getElementById("form-content").style.display = "none";
      return;
    }
    document.getElementById("not-found").style.display = "none";
    document.getElementById("form-content").style.display = "block";

    document.getElementById("f-title").textContent = record.runNumber
      ? record.runNumber + " (" + record.referenceNo + ")"
      : record.referenceNo;

    renderPrintForm(record);
    applyIcons();
  }

  document.addEventListener("odprs:langchange", render);
  fetchRecord().then(render);
</script>
</body>
</html>
