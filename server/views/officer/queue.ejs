<%- include("../partials/head", { title: "ODPRS — คิวรอเอกสารต้นฉบับ" }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.officerQueue", crumbFallback: 'คิวรอเอกสารต้นฉบับ / <strong>ภาพรวม</strong>' }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="officerQueue.title">คิวรอเอกสารต้นฉบับ</h1>
    <p class="page-subtitle" data-i18n="officerQueue.subtitle">รายการคำขอที่รอผู้ขอนำเอกสารต้นฉบับมาส่งที่เคาน์เตอร์</p>

    <div class="card">
      <div class="card-header">
        <label style="display:flex; align-items:center; gap:8px; font-weight:400; font-size:14px; cursor:pointer;">
          <input type="checkbox" id="overdue-filter">
          <span data-i18n="officerQueue.filterLabel">แสดงเฉพาะที่เลยกำหนดส่ง (ค้าง)</span>
        </label>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="officerQueue.th.ref">เลขอ้างอิงคำขอ</th>
              <th data-i18n="officerQueue.th.requester">ผู้ขอ</th>
              <th data-i18n="officerQueue.th.agency">หน่วยงาน</th>
              <th data-i18n="officerQueue.th.submitted">วันที่ส่งคำขอ</th>
              <th data-i18n="officerQueue.th.deadline">กำหนดส่งต้นฉบับ</th>
              <th data-i18n="officerQueue.th.status">สถานะ</th>
            </tr>
          </thead>
          <tbody id="queue-body"></tbody>
        </table>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  // Only ever fetches the (naturally small) awaiting-original-document
  // slice — filtered server-side — instead of every request in the system.
  let allRequests = [];

  async function loadRequests() {
    const res = await fetch("/api/requests/awaiting");
    allRequests = await res.json();
  }

  function renderQueue() {
    const lang = getLang();
    const showOverdueOnly = document.getElementById("overdue-filter").checked;

    const records = allRequests
      .filter(function (r) { return !showOverdueOnly || isOverdue(r); })
      .sort(function (a, b) { return new Date(a.submissionDate) - new Date(b.submissionDate); });

    const tbody = document.getElementById("queue-body");

    if (records.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">' + t("officerQueue.empty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = records.map(function (r) {
      const agencyLabel = lang === "en" ? (AGENCY_CATEGORY_EN[r.agencyCategory] || r.agencyCategory) : r.agencyCategory;
      const statusBadge = isOverdue(r)
        ? '<span class="badge badge-overdue">' + t("officerQueue.overdue") + '</span>'
        : '<span class="badge badge-awaiting">' + t("status.awaiting") + '</span>';

      return '<tr data-ref="' + r.referenceNo + '">' +
        '<td>' + r.referenceNo + '</td>' +
        '<td>' + r.requesterName + '</td>' +
        '<td>' + agencyLabel + '</td>' +
        '<td>' + formatDateTime(new Date(r.submissionDate), lang) + '</td>' +
        '<td>' + formatDateTime(new Date(r.dropoffDeadlineDate), lang) + '</td>' +
        '<td>' + statusBadge + '</td>' +
        '</tr>';
    }).join("");

    tbody.querySelectorAll("tr[data-ref]").forEach(function (tr) {
      tr.style.cursor = "pointer";
      tr.addEventListener("click", function () {
        window.location.href = "/officer/request-detail?ref=" + encodeURIComponent(this.getAttribute("data-ref"));
      });
    });
  }

  document.getElementById("overdue-filter").addEventListener("change", renderQueue);
  document.addEventListener("odprs:langchange", renderQueue);
  loadRequests().then(renderQueue);
</script>
</body>
</html>
