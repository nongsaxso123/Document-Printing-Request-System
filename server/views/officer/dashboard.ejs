<%- include("../partials/head", { title: "ODPRS — แดชบอร์ดสรุปข้อมูล" }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.dashboard", crumbFallback: "แดชบอร์ดสรุปข้อมูล / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="dashboard.title">แดชบอร์ดสรุปข้อมูล</h1>
    <p class="page-subtitle" data-i18n="dashboard.subtitle">ภาพรวมปริมาณคำขอและการพิมพ์ ใช้ประกอบการประมาณการงบประมาณ</p>

    <div class="card">
      <div class="card-body">
        <div class="form-grid">
          <div class="field">
            <label data-i18n="dashboard.yearFilter">ปีที่ต้องการดู</label>
            <select id="dash-year-filter"></select>
          </div>
        </div>
        <p class="hint" style="margin-top:10px;" data-i18n="dashboard.filterNote">ตัวกรองปีนี้มีผลกับสถิติและกราฟทุกส่วนด้านล่าง ยกเว้นกราฟ "แนวโน้มรายปี" ซึ่งแสดงทุกปีเสมอเพื่อการเปรียบเทียบ</p>
      </div>
    </div>

    <div class="stat-grid">
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.totalRequests">จำนวนคำขอทั้งหมด</div>
          <div class="stat-value" id="kpi-total-requests">—</div>
        </div>
      </div>
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.totalCopies">จำนวนชุดที่ปริ้นแล้ว (รวม)</div>
          <div class="stat-value" id="kpi-total-copies">—</div>
        </div>
      </div>
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.totalPages">จำนวนหน้าที่ปริ้นแล้ว (รวม)</div>
          <div class="stat-value" id="kpi-total-pages">—</div>
        </div>
      </div>
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.completionRate">อัตราคำขอที่สำเร็จ</div>
          <div class="stat-value" id="kpi-completion-rate">—</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="dashboard.trendTitle">จำนวนคำขอต่อปี</span>
        <span class="hint" data-i18n="dashboard.trendNote">ภาพรวมทุกปี (ไม่ผูกกับตัวกรองด้านบน)</span>
      </div>
      <div class="card-body">
        <div id="year-chart" class="viz-col-chart"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="dashboard.agencyCountTitle">จำนวนคำขอ แยกตามประเภทหน่วยงาน</span>
      </div>
      <div class="card-body">
        <div id="agency-count-chart" class="viz-bar-chart"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="dashboard.agencyPagesTitle">จำนวนหน้าที่ปริ้นรวม แยกตามประเภทหน่วยงาน</span>
      </div>
      <div class="card-body">
        <p class="hint" style="margin-bottom:14px;" data-i18n="dashboard.agencyPagesNote">คำนวณจากคำขอที่ได้รับการอนุมัติและปริ้นแล้วเท่านั้น (ไม่รวมคำขอที่ถูกปฏิเสธหรือยังรอเอกสารต้นฉบับ) — ใช้ตัวเลขนี้ประกอบการประมาณการงบประมาณ</p>
        <div id="agency-pages-chart" class="viz-bar-chart"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><span data-i18n="dashboard.tableTitle">ตารางสรุปรายหน่วยงาน</span></div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="dashboard.th.agency">ประเภทหน่วยงาน</th>
              <th data-i18n="dashboard.th.requests">จำนวนคำขอ</th>
              <th data-i18n="dashboard.th.copies">จำนวนชุดที่ปริ้นแล้ว</th>
              <th data-i18n="dashboard.th.pages">จำนวนหน้าที่ปริ้นแล้ว</th>
              <th data-i18n="dashboard.th.avgPages">เฉลี่ยหน้า/คำขอ</th>
            </tr>
          </thead>
          <tbody id="summary-table-body"></tbody>
        </table>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  const yearFilter = document.getElementById("dash-year-filter");
  const PRINTED_STATUSES = ["printing", "ready", "completed"];

  let allRequests = [];

  async function loadRequests() {
    const res = await fetch("/api/requests");
    allRequests = await res.json();
  }

  function formatNumber(n) {
    return n.toLocaleString(getLang() === "en" ? "en-US" : "th-TH");
  }

  function renderYearFilterOptions() {
    const lang = getLang();
    const previous = yearFilter.value;
    yearFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("dashboard.yearFilter.all");
    yearFilter.appendChild(allOpt);

    const years = Array.from(new Set(allRequests.map(function (r) {
      return new Date(r.submissionDate).getFullYear();
    }))).sort(function (a, b) { return b - a; });

    years.forEach(function (year) {
      const opt = document.createElement("option");
      opt.value = String(year);
      opt.textContent = lang === "en" ? String(year) : String(year + 543);
      yearFilter.appendChild(opt);
    });

    yearFilter.value = previous;
  }

  function computeAgencyBreakdown(records) {
    const map = {};
    records.forEach(function (r) {
      if (!map[r.agencyCategory]) map[r.agencyCategory] = { count: 0, copies: 0, pages: 0 };
      map[r.agencyCategory].count += 1;
      if (PRINTED_STATUSES.indexOf(r.statusCode) !== -1) {
        const pages = Number(r.originalPages || 0) * Number(r.copies || 0);
        map[r.agencyCategory].copies += Number(r.copies || 0);
        map[r.agencyCategory].pages += pages;
      }
    });
    return Object.keys(map).map(function (category) {
      return { category: category, count: map[category].count, copies: map[category].copies, pages: map[category].pages };
    });
  }

  function renderBarChart(containerId, items, valueKey) {
    const lang = getLang();
    const container = document.getElementById(containerId);
    const sorted = items.filter(function (it) { return it[valueKey] > 0; })
      .sort(function (a, b) { return b[valueKey] - a[valueKey]; });

    if (sorted.length === 0) {
      container.innerHTML = '<div class="empty-state">' + t("dashboard.noData") + '</div>';
      return;
    }

    const max = sorted[0][valueKey];

    container.innerHTML = sorted.map(function (it, index) {
      const label = lang === "en" ? (AGENCY_CATEGORY_EN[it.category] || it.category) : it.category;
      const pct = max > 0 ? Math.round((it[valueKey] / max) * 100) : 0;
      let badge = "";
      if (index === 0) badge = '<span class="viz-bar-badge highest">' + t("dashboard.highest") + '</span>';
      else if (index === sorted.length - 1 && sorted.length > 1) badge = '<span class="viz-bar-badge lowest">' + t("dashboard.lowest") + '</span>';

      return '<div class="viz-bar-row" title="' + label + ': ' + formatNumber(it[valueKey]) + '">' +
        '<div class="viz-bar-label">' + label + '</div>' +
        '<div class="viz-bar-track"><div class="viz-bar-fill" style="width:' + pct + '%"></div></div>' +
        '<div class="viz-bar-value">' + formatNumber(it[valueKey]) + '</div>' +
        badge +
        '</div>';
    }).join("");
  }

  function renderYearChart() {
    const lang = getLang();
    const counts = {};
    allRequests.forEach(function (r) {
      const y = new Date(r.submissionDate).getFullYear();
      counts[y] = (counts[y] || 0) + 1;
    });

    const years = Object.keys(counts).map(Number).sort(function (a, b) { return a - b; });
    const container = document.getElementById("year-chart");

    if (years.length === 0) {
      container.innerHTML = '<div class="empty-state">' + t("dashboard.noData") + '</div>';
      return;
    }

    const max = Math.max.apply(null, years.map(function (y) { return counts[y]; }));

    container.innerHTML = years.map(function (y) {
      const value = counts[y];
      const heightPct = max > 0 ? Math.round((value / max) * 100) : 0;
      const label = lang === "en" ? String(y) : String(y + 543);
      return '<div class="viz-col" title="' + label + ': ' + formatNumber(value) + '">' +
        '<div class="viz-col-value">' + formatNumber(value) + '</div>' +
        '<div class="viz-col-bar-zone"><div class="viz-col-bar" style="height:' + heightPct + '%"></div></div>' +
        '<div class="viz-col-label">' + label + '</div>' +
        '</div>';
    }).join("");
  }

  function renderSummaryTable(items) {
    const lang = getLang();
    const tbody = document.getElementById("summary-table-body");
    const sorted = items.slice().sort(function (a, b) { return b.pages - a.pages; });

    if (sorted.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state">' + t("dashboard.noData") + '</td></tr>';
      return;
    }

    tbody.innerHTML = sorted.map(function (it) {
      const label = lang === "en" ? (AGENCY_CATEGORY_EN[it.category] || it.category) : it.category;
      const avgPages = it.count > 0 ? Math.round(it.pages / it.count) : 0;
      return '<tr>' +
        '<td>' + label + '</td>' +
        '<td>' + formatNumber(it.count) + '</td>' +
        '<td>' + formatNumber(it.copies) + '</td>' +
        '<td>' + formatNumber(it.pages) + '</td>' +
        '<td>' + formatNumber(avgPages) + '</td>' +
        '</tr>';
    }).join("");
  }

  function renderAll() {
    const records = allRequests
      .filter(function (r) { return !yearFilter.value || new Date(r.submissionDate).getFullYear() === Number(yearFilter.value); });

    const totalRequests = records.length;
    const printedRecords = records.filter(function (r) { return PRINTED_STATUSES.indexOf(r.statusCode) !== -1; });
    const totalCopies = printedRecords.reduce(function (sum, r) { return sum + Number(r.copies || 0); }, 0);
    const totalPages = printedRecords.reduce(function (sum, r) { return sum + Number(r.originalPages || 0) * Number(r.copies || 0); }, 0);
    const completed = records.filter(function (r) { return r.statusCode === "completed"; }).length;
    const completionRate = totalRequests > 0 ? Math.round((completed / totalRequests) * 100) : 0;

    document.getElementById("kpi-total-requests").textContent = formatNumber(totalRequests);
    document.getElementById("kpi-total-copies").textContent = formatNumber(totalCopies);
    document.getElementById("kpi-total-pages").textContent = formatNumber(totalPages);
    document.getElementById("kpi-completion-rate").textContent = completionRate + "%";

    const breakdown = computeAgencyBreakdown(records);
    renderBarChart("agency-count-chart", breakdown, "count");
    renderBarChart("agency-pages-chart", breakdown, "pages");
    renderSummaryTable(breakdown);
    renderYearChart();
  }

  yearFilter.addEventListener("change", renderAll);

  document.addEventListener("odprs:langchange", function () {
    renderYearFilterOptions();
    renderAll();
  });

  loadRequests().then(function () {
    renderYearFilterOptions();
    renderAll();
  });
</script>
</body>
</html>
