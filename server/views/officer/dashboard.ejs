<%- include("../partials/head", { title: "ODPRS — แดชบอร์ดสรุปข้อมูล" }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.dashboard", crumbFallback: "แดชบอร์ดสรุปข้อมูล / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="dashboard.title">แดชบอร์ดสรุปข้อมูล</h1>
    <p class="page-subtitle" data-i18n="dashboard.subtitle">ภาพรวมการใช้ทรัพยากรกระดาษ แยกตามหน่วยงานและประเภทหน่วยงาน สำหรับใช้รายงานต่อมหาวิทยาลัย</p>

    <div class="card">
      <div class="card-body">
        <div class="form-grid">
          <div class="field">
            <label data-i18n="dashboard.yearFilter">ปีที่ต้องการดู</label>
            <select id="dash-year-filter"></select>
          </div>
          <div class="field">
            <label data-i18n="dashboard.documentTypeFilter">ประเภทเอกสาร</label>
            <select id="dash-document-type-filter">
              <option value="" data-i18n="dashboard.documentTypeFilter.all">ทั้งหมด</option>
              <option value="ข้อสอบ" data-i18n="dashboard.documentTypeFilter.exam">ข้อสอบ</option>
              <option value="เอกสารทั่วไป" data-i18n="dashboard.documentTypeFilter.general">เอกสารทั่วไป</option>
            </select>
          </div>
          <div class="field">
            <label data-i18n="dashboard.paperSourceFilter">แหล่งที่มากระดาษ</label>
            <select id="dash-paper-source-filter">
              <option value="" data-i18n="dashboard.paperSourceFilter.all">ทั้งหมด</option>
              <option value="ฝ่ายทะเบียนจัดเตรียมให้" selected data-i18n="dashboard.paperSourceFilter.office">ฝ่ายทะเบียนจัดเตรียมให้</option>
              <option value="ผู้ขอจัดเตรียมเอง" data-i18n="dashboard.paperSourceFilter.requester">ผู้ขอจัดเตรียมเอง</option>
            </select>
          </div>
        </div>
        <p class="hint" style="margin-top:10px;" data-i18n="dashboard.filterNote">ตัวกรองปีนี้มีผลกับสถิติและกราฟทุกส่วนด้านล่าง ยกเว้นกราฟ "แนวโน้มรายปี" ซึ่งแสดงทุกปีเสมอเพื่อการเปรียบเทียบ</p>
        <p class="hint" style="margin-top:4px;" data-i18n="dashboard.paperSourceDefaultNote">ค่าเริ่มต้นแสดงเฉพาะกระดาษที่ฝ่ายทะเบียนจัดเตรียมให้ ซึ่งเป็นตัวเลขที่ใช้รายงานงบประมาณจริงของฝ่าย — เอกสารทั่วไปถูกกำหนดให้ผู้ขอจัดเตรียมกระดาษเองเสมอ จึงไม่นับรวมในค่าเริ่มต้นนี้</p>
      </div>
    </div>

    <div class="stat-grid">
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.totalRequests">จำนวนคำขอทั้งหมด</div>
          <div class="stat-value" id="kpi-total-requests">—</div>
        </div>
      </div>
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.totalSheets">จำนวนแผ่นกระดาษที่ใช้ไป (รวม)</div>
          <div class="stat-value" id="kpi-total-sheets">—</div>
        </div>
      </div>
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.avgSheets">เฉลี่ยแผ่นกระดาษ/คำขอ</div>
          <div class="stat-value" id="kpi-avg-sheets">—</div>
        </div>
      </div>
      <div class="card stat-tile">
        <div class="card-body">
          <div class="stat-label" data-i18n="dashboard.kpi.activeUnits">จำนวนหน่วยงานที่มีการใช้งาน</div>
          <div class="stat-value" id="kpi-active-units">—</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="dashboard.trendSheetsTitle">จำนวนแผ่นกระดาษที่ใช้ต่อปี</span>
        <span class="hint" data-i18n="dashboard.trendNote">แสดงทุกปีเสมอ (ไม่ผูกกับตัวกรองปีด้านบน แต่ยังคงผูกกับตัวกรองประเภทเอกสาร/แหล่งที่มากระดาษ)</span>
      </div>
      <div class="card-body">
        <div id="year-sheets-chart" class="viz-col-chart"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="dashboard.categorySheetsTitle">จำนวนแผ่นกระดาษที่ใช้ แยกตามประเภทหน่วยงาน</span>
      </div>
      <div class="card-body">
        <p class="hint" style="margin-bottom:14px;" data-i18n="dashboard.sheetsNote">คำนวณจากคำขอที่ได้รับการอนุมัติและปริ้นแล้วเท่านั้น (ไม่รวมคำขอที่ถูกปฏิเสธหรือยังรอเอกสารต้นฉบับ) นับเป็นจำนวนแผ่นกระดาษจริงที่ใช้ (พิมพ์สองหน้านับครึ่งหนึ่งของจำนวนหน้า) — ใช้ตัวเลขนี้ประกอบการรายงานและประมาณการงบประมาณ</p>
        <div id="category-sheets-chart" class="viz-bar-chart"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><span data-i18n="dashboard.categoryTableTitle">ตารางสรุปรายประเภทหน่วยงาน</span></div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="dashboard.th.category">ประเภทหน่วยงาน</th>
              <th data-i18n="dashboard.th.requests">จำนวนคำขอ</th>
              <th data-i18n="dashboard.th.copies">จำนวนชุดที่ปริ้นแล้ว</th>
              <th data-i18n="dashboard.th.sheets">จำนวนแผ่นกระดาษที่ใช้</th>
              <th data-i18n="dashboard.th.avgSheets">เฉลี่ยแผ่น/คำขอ</th>
            </tr>
          </thead>
          <tbody id="category-table-body"></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span data-i18n="dashboard.unitTopTitle">10 อันดับหน่วยงานที่ใช้กระดาษมากที่สุด</span>
      </div>
      <div class="card-body">
        <div id="unit-top-chart" class="viz-bar-chart"></div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><span data-i18n="dashboard.unitTableTitle">ตารางสรุปรายหน่วยงาน (ทั้งหมด)</span></div>
      <div class="card-body">
        <div class="form-grid">
          <div class="field span-2">
            <label data-i18n="dashboard.unitSearchLabel">ค้นหาหน่วยงาน</label>
            <input type="text" id="unit-search-input" data-i18n-placeholder="dashboard.unitSearchPlaceholder" placeholder="พิมพ์ชื่อหน่วยงาน">
          </div>
          <div class="field">
            <label data-i18n="dashboard.unitCategoryFilterLabel">กรองตามประเภทหน่วยงาน</label>
            <select id="unit-category-filter"></select>
          </div>
        </div>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="dashboard.th.unit">หน่วยงาน</th>
              <th data-i18n="dashboard.th.category">ประเภทหน่วยงาน</th>
              <th data-i18n="dashboard.th.requests">จำนวนคำขอ</th>
              <th data-i18n="dashboard.th.copies">จำนวนชุดที่ปริ้นแล้ว</th>
              <th data-i18n="dashboard.th.sheets">จำนวนแผ่นกระดาษที่ใช้</th>
              <th data-i18n="dashboard.th.avgSheets">เฉลี่ยแผ่น/คำขอ</th>
            </tr>
          </thead>
          <tbody id="unit-table-body"></tbody>
        </table>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  // The dashboard used to GET /api/requests (every raw row) and aggregate in
  // browser JS — fine at a few dozen rows, visibly slow once the table has
  // tens of thousands. All aggregation now happens server-side
  // (GET /api/dashboard-summary); the browser only ever handles small,
  // pre-summarized arrays (per-category, per-unit), regardless of how many
  // total requests exist.
  const yearFilter = document.getElementById("dash-year-filter");
  const documentTypeFilter = document.getElementById("dash-document-type-filter");
  const paperSourceFilter = document.getElementById("dash-paper-source-filter");
  const unitCategoryFilter = document.getElementById("unit-category-filter");
  const unitSearchInput = document.getElementById("unit-search-input");

  let summary = null;

  async function fetchSummary() {
    const params = new URLSearchParams();
    if (yearFilter.value) params.set("year", yearFilter.value);
    if (documentTypeFilter.value) params.set("documentType", documentTypeFilter.value);
    if (paperSourceFilter.value) params.set("paperSource", paperSourceFilter.value);
    const res = await fetch("/api/dashboard-summary?" + params.toString());
    summary = await res.json();
  }

  function formatNumber(n) {
    return n.toLocaleString(getLang() === "en" ? "en-US" : "th-TH");
  }

  function categoryLabelFor(category) {
    const lang = getLang();
    return lang === "en" ? (AGENCY_CATEGORY_EN[category] || category) : category;
  }

  function renderYearFilterOptions() {
    const lang = getLang();
    const previous = yearFilter.value;
    yearFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("dashboard.yearFilter.all");
    yearFilter.appendChild(allOpt);

    (summary.availableYears || []).forEach(function (year) {
      const opt = document.createElement("option");
      opt.value = String(year);
      opt.textContent = lang === "en" ? String(year) : String(year + 543);
      yearFilter.appendChild(opt);
    });

    yearFilter.value = previous;
  }

  function renderUnitCategoryFilterOptions() {
    const previous = unitCategoryFilter.value;
    unitCategoryFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("dashboard.unitCategoryFilter.all");
    unitCategoryFilter.appendChild(allOpt);

    const categories = summary.categoryBreakdown.map(function (c) { return c.category; }).sort();
    categories.forEach(function (category) {
      const opt = document.createElement("option");
      opt.value = category;
      opt.textContent = categoryLabelFor(category);
      unitCategoryFilter.appendChild(opt);
    });

    unitCategoryFilter.value = previous;
  }

  function renderBarChart(containerId, items, valueKey, labelFn) {
    const container = document.getElementById(containerId);
    const sorted = items.filter(function (it) { return it[valueKey] > 0; })
      .sort(function (a, b) { return b[valueKey] - a[valueKey]; });

    if (sorted.length === 0) {
      container.innerHTML = '<div class="empty-state">' + t("dashboard.noData") + '</div>';
      return;
    }

    const max = sorted[0][valueKey];

    container.innerHTML = sorted.map(function (it, index) {
      const label = labelFn(it);
      const pct = max > 0 ? Math.round((it[valueKey] / max) * 100) : 0;
      let badge = "";
      if (index === 0) badge = '<span class="viz-bar-badge highest">' + t("dashboard.highest") + '</span>';
      else if (index === sorted.length - 1 && sorted.length > 1) badge = '<span class="viz-bar-badge lowest">' + t("dashboard.lowest") + '</span>';

      return '<div class="viz-bar-row" title="' + label + ': ' + formatNumber(it[valueKey]) + '">' +
        '<div class="viz-bar-label">' + label + '</div>' +
        '<div class="viz-bar-track"><div class="viz-bar-fill" style="width:' + pct + '%"></div></div>' +
        '<div class="viz-bar-value">' + formatNumber(it[valueKey]) + '</div>' +
        badge +
        '</div>';
    }).join("");
  }

  function renderYearColumnChart(containerId, counts) {
    const lang = getLang();
    const years = Object.keys(counts).map(Number).sort(function (a, b) { return a - b; });
    const container = document.getElementById(containerId);

    if (years.length === 0) {
      container.innerHTML = '<div class="empty-state">' + t("dashboard.noData") + '</div>';
      return;
    }

    const max = Math.max.apply(null, years.map(function (y) { return counts[y]; }));

    container.innerHTML = years.map(function (y) {
      const value = counts[y];
      const heightPct = max > 0 ? Math.round((value / max) * 100) : 0;
      const label = lang === "en" ? String(y) : String(y + 543);
      return '<div class="viz-col" title="' + label + ': ' + formatNumber(value) + '">' +
        '<div class="viz-col-value">' + formatNumber(value) + '</div>' +
        '<div class="viz-col-bar-zone"><div class="viz-col-bar" style="height:' + heightPct + '%"></div></div>' +
        '<div class="viz-col-label">' + label + '</div>' +
        '</div>';
    }).join("");
  }

  function renderCategoryTable(items) {
    const tbody = document.getElementById("category-table-body");
    const sorted = items.slice().sort(function (a, b) { return b.sheets - a.sheets; });

    if (sorted.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state">' + t("dashboard.noData") + '</td></tr>';
      return;
    }

    tbody.innerHTML = sorted.map(function (it) {
      const avgSheets = it.count > 0 ? Math.round(it.sheets / it.count) : 0;
      return '<tr>' +
        '<td>' + categoryLabelFor(it.category) + '</td>' +
        '<td>' + formatNumber(it.count) + '</td>' +
        '<td>' + formatNumber(it.copies) + '</td>' +
        '<td>' + formatNumber(it.sheets) + '</td>' +
        '<td>' + formatNumber(avgSheets) + '</td>' +
        '</tr>';
    }).join("");
  }

  // Filtered/searched purely client-side — summary.unitBreakdown is already
  // a small pre-aggregated array (bounded by the number of distinct
  // departments, not by how many total requests exist), so no server
  // round-trip is needed just to search or narrow by category.
  function renderUnitTable(items) {
    const tbody = document.getElementById("unit-table-body");
    const query = unitSearchInput.value.trim().toLowerCase();
    const category = unitCategoryFilter.value;

    const filtered = items.filter(function (it) {
      if (category && it.category !== category) return false;
      if (query && it.unit.toLowerCase().indexOf(query) === -1) return false;
      return true;
    });

    const sorted = filtered.slice().sort(function (a, b) { return b.sheets - a.sheets; });

    if (sorted.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">' + t("dashboard.noData") + '</td></tr>';
      return;
    }

    tbody.innerHTML = sorted.map(function (it) {
      const avgSheets = it.count > 0 ? Math.round(it.sheets / it.count) : 0;
      return '<tr>' +
        '<td>' + it.unit + '</td>' +
        '<td>' + categoryLabelFor(it.category) + '</td>' +
        '<td>' + formatNumber(it.count) + '</td>' +
        '<td>' + formatNumber(it.copies) + '</td>' +
        '<td>' + formatNumber(it.sheets) + '</td>' +
        '<td>' + formatNumber(avgSheets) + '</td>' +
        '</tr>';
    }).join("");
  }

  function renderAll() {
    document.getElementById("kpi-total-requests").textContent = formatNumber(summary.totalRequests);
    document.getElementById("kpi-total-sheets").textContent = formatNumber(summary.totalSheets);
    document.getElementById("kpi-avg-sheets").textContent = formatNumber(summary.avgSheets);
    document.getElementById("kpi-active-units").textContent = formatNumber(summary.activeUnits);

    renderBarChart("category-sheets-chart", summary.categoryBreakdown, "sheets", function (it) { return categoryLabelFor(it.category); });
    renderCategoryTable(summary.categoryBreakdown);

    const top10 = summary.unitBreakdown.slice().sort(function (a, b) { return b.sheets - a.sheets; }).slice(0, 10);
    renderBarChart("unit-top-chart", top10, "sheets", function (it) { return it.unit; });
    renderUnitTable(summary.unitBreakdown);

    renderYearColumnChart("year-sheets-chart", summary.yearTrend);
  }

  // Year/document-type/paper-source changes need a fresh server-side
  // aggregation; unit search/category-filter only re-slice the array already
  // in memory.
  async function reload() {
    await fetchSummary();
    renderYearFilterOptions();
    renderUnitCategoryFilterOptions();
    renderAll();
  }

  yearFilter.addEventListener("change", reload);
  documentTypeFilter.addEventListener("change", reload);
  paperSourceFilter.addEventListener("change", reload);
  unitCategoryFilter.addEventListener("change", function () { renderUnitTable(summary.unitBreakdown); });
  unitSearchInput.addEventListener("input", function () { renderUnitTable(summary.unitBreakdown); });

  document.addEventListener("odprs:langchange", function () {
    renderYearFilterOptions();
    renderUnitCategoryFilterOptions();
    renderAll();
  });

  reload();
</script>
</body>
</html>
