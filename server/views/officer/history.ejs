<%- include("../partials/head", { title: "ประวัติคำขอทั้งหมด | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.history", crumbFallback: 'ประวัติคำขอทั้งหมด / <strong>ภาพรวม</strong>' }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="history.title">ประวัติคำขอทั้งหมด</h1>
    <p class="page-subtitle" data-i18n="history.subtitle">ค้นหาและตรวจสอบคำขอทุกรายการในระบบ ไม่ว่าจะอยู่สถานะใด</p>

    <div class="card filter-panel">
      <div class="card-body">
        <div class="filter-top">
          <div class="filter-search">
            <span class="icon filter-search-icon" data-icon="search"><%- icon('search') %></span>
            <input type="text" id="search-input" data-i18n-placeholder="history.searchPlaceholder"
                   placeholder="RUN NUMBER, เลขอ้างอิง, ชื่อผู้ขอ/ผู้รับ, หรือ Claim Code">
          </div>
          <button type="button" class="btn btn-secondary filter-toggle" id="history-filter-toggle" aria-expanded="false" aria-controls="history-filter-body">
              <span data-i18n="filter.toggle">ตัวกรอง</span>
              <span class="filter-toggle-count" id="history-filter-count" hidden></span>
              <span class="icon filter-toggle-chevron" data-icon="chevron-down"><%- icon('chevron-down') %></span>
            </button>
        </div>

        <div class="filter-collapse" id="history-filter-body">
        <div class="filter-collapse-inner">
        <div class="filter-row">
          <div class="filter-group">
            <div class="filter-head"><span class="filter-label" data-i18n="filter.status">สถานะ</span></div>
            <div class="filter-controls">
              <select id="status-filter" class="toolbar-select">
                <option value="" data-i18n="history.filterStatus.all">ทุกสถานะ</option>
                <option value="awaiting" data-i18n="status.awaiting">รอส่งเอกสารต้นฉบับ</option>
                <option value="printing" data-i18n="status.printing">กำลังปริ้น</option>
                <option value="ready" data-i18n="status.ready">พร้อมส่งมอบ</option>
                <option value="completed" data-i18n="status.completed">เสร็จสมบูรณ์</option>
                <option value="rejected" data-i18n="status.rejected">ถูกปฏิเสธ</option>
                <option value="cancelled" data-i18n="status.cancelled">ยกเลิกโดยผู้ขอ</option>
              </select>
            </div>
          </div>

          <div class="filter-group">
            <div class="filter-head"><span class="filter-label" data-i18n="filter.unit">หน่วยงาน</span></div>
            <div class="filter-controls">
              <select id="unit-filter" class="toolbar-select"></select>
            </div>
          </div>

          <div class="filter-group">
            <div class="filter-head">
              <span class="filter-label" data-i18n="dashboard.filter.period">ช่วงเวลา</span>
              <label class="filter-switch">
                <input type="checkbox" id="custom-range-toggle">
                <span data-i18n="dashboard.dateMode.custom">กำหนดช่วงวันที่เอง</span>
              </label>
            </div>
            <div id="calendar-fields" class="filter-controls">
              <select id="year-filter" class="toolbar-select"></select>
              <select id="month-filter" class="toolbar-select"></select>
            </div>
            <div id="custom-range-fields" class="filter-controls" hidden>
              <input type="date" id="from-date" class="toolbar-select">
              <span class="filter-to" data-i18n="dashboard.dateMode.rangeTo">ถึง</span>
              <input type="date" id="to-date" class="toolbar-select">
              <button type="button" id="custom-range-clear" class="filter-clear" data-i18n="dashboard.dateMode.clear">ล้าง</button>
            </div>
          </div>
        </div>
        </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span id="result-count"></span>
        <div class="tab-row-actions">
        <button type="button" class="export-btn" id="history-export-btn">
          <span class="icon" data-icon="download"><%- icon('download') %></span>
          <span class="export-btn-label" data-i18n="export.excel">ส่งออก Excel</span>
        </button>
        <label style="display:flex; align-items:center; gap:8px; font-weight:400; font-size:13px;">
          <span data-i18n="history.rowsPerPage">แสดงต่อหน้า</span>
          <select id="page-size-select" style="padding:6px 10px; border:1px solid var(--color-border); border-radius:8px; font-family:var(--font-family); font-size:13px;">
            <option value="10">10</option>
            <option value="20" selected>20</option>
            <option value="50">50</option>
          </select>
        </label>
        </div>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="history.th.ref">เลขอ้างอิง / RUN NUMBER</th>
              <th data-i18n="history.th.requester">ผู้ขอ</th>
              <th data-i18n="history.th.unit">หน่วยงาน</th>
              <th data-i18n="history.th.item">รายการ</th>
              <th data-i18n="history.th.submitted">วันที่ส่งคำขอ</th>
              <th data-i18n="history.th.status">สถานะ</th>
              <th data-i18n="history.th.officer">เจ้าหน้าที่ผู้ดำเนินการ</th>
              <th data-i18n="history.th.form">ใบคำขอ</th>
            </tr>
          </thead>
          <tbody id="history-body"></tbody>
        </table>
      </div>
      <div class="card-body" style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid var(--color-border);">
        <span id="page-info" style="font-size:13px; color:var(--color-muted);"></span>
        <div style="display:flex; gap:8px;">
          <button class="btn btn-secondary" id="prev-page-btn" data-i18n="history.prevPage">‹ ก่อนหน้า</button>
          <button class="btn btn-secondary" id="next-page-btn" data-i18n="history.nextPage">ถัดไป ›</button>
        </div>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  const searchInput = document.getElementById("search-input");
  const statusFilter = document.getElementById("status-filter");
  const unitFilter = document.getElementById("unit-filter");
  const calendarFields = document.getElementById("calendar-fields");
  const yearFilter = document.getElementById("year-filter");
  const monthFilter = document.getElementById("month-filter");
  const customRangeToggle = document.getElementById("custom-range-toggle");
  const customRangeFields = document.getElementById("custom-range-fields");
  const customRangeClearBtn = document.getElementById("custom-range-clear");
  const fromDateInput = document.getElementById("from-date");
  const toDateInput = document.getElementById("to-date");

  // Search/filter/sort/pagination all happen server-side now (GET
  // /api/requests/history) — fetching every request up front and doing all
  // of that in browser JS visibly slowed the page down once the table grew
  // into the tens of thousands of rows.
  function debounce(fn, delay) {
    let timer;
    return function () {
      const args = arguments;
      const self = this;
      clearTimeout(timer);
      timer = setTimeout(function () { fn.apply(self, args); }, delay);
    };
  }

  async function loadAvailableYears() {
    const res = await fetch("/api/requests/years");
    return res.json();
  }

  // All unit types (active + archived — a past request can reference
  // one since archived, see src/units.js) for the filter dropdown; the
  // option's value stays the category's Thai name, matching what
  // searchHistory's unitType filter compares against on the raw
  // stored string column (unchanged by the E track — see requests.js).
  let UNIT_TYPES = [];
  async function loadUnitTypes() {
    const res = await fetch("/api/unit-types");
    return res.ok ? res.json() : [];
  }

  function renderUnitFilterOptions() {
    const lang = getLang();
    const previous = unitFilter.value;
    unitFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("history.filterUnit.all");
    unitFilter.appendChild(allOpt);

    UNIT_TYPES.forEach(function (category) {
      const opt = document.createElement("option");
      opt.value = category.nameTh;
      opt.textContent = pickLang(category.nameTh, category.nameEn, lang);
      unitFilter.appendChild(opt);
    });

    unitFilter.value = previous;
  }

  let availableYears = [];

  function renderYearFilterOptions() {
    const lang = getLang();
    const previous = yearFilter.value;
    yearFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("history.filterYear.all");
    yearFilter.appendChild(allOpt);

    availableYears.forEach(function (year) {
      const opt = document.createElement("option");
      opt.value = String(year);
      opt.textContent = lang === "en" ? String(year) : String(year + 543);
      yearFilter.appendChild(opt);
    });

    yearFilter.value = previous;
  }

  function renderMonthFilterOptions() {
    const lang = getLang();
    const previous = monthFilter.value;
    monthFilter.innerHTML = "";

    const allOpt = document.createElement("option");
    allOpt.value = "";
    allOpt.textContent = t("history.filterMonth.all");
    monthFilter.appendChild(allOpt);

    const months = lang === "en" ? ENG_MONTHS : THAI_MONTHS;
    months.forEach(function (label, index) {
      const opt = document.createElement("option");
      opt.value = String(index);
      opt.textContent = label;
      monthFilter.appendChild(opt);
    });

    monthFilter.value = previous;
  }

  const pageSizeSelect = document.getElementById("page-size-select");
  const prevPageBtn = document.getElementById("prev-page-btn");
  const nextPageBtn = document.getElementById("next-page-btn");
  let currentPage = 1;
  let requestSeq = 0; // guards against an older, slower fetch overwriting a newer one's result

  // The current filters as query params — shared by the table fetch and
  // the Excel export, so the file always matches what's on screen.
  function historyFilterParams() {
    const params = new URLSearchParams();
    if (statusFilter.value) params.set("status", statusFilter.value);
    if (unitFilter.value) params.set("unitType", unitFilter.value);
    if (customRangeToggle.checked) {
      if (fromDateInput.value) params.set("fromDate", fromDateInput.value);
      if (toDateInput.value) params.set("toDate", toDateInput.value);
    } else {
      if (yearFilter.value) params.set("year", yearFilter.value);
      if (monthFilter.value !== "") params.set("month", monthFilter.value);
    }
    if (searchInput.value.trim()) params.set("q", searchInput.value.trim());
    return params;
  }

  document.getElementById("history-export-btn").addEventListener("click", function () {
    downloadReport("/api/reports/history.xlsx?" + historyFilterParams().toString(), this);
  });

  async function renderHistory() {
    const lang = getLang();
    const pageSize = Number(pageSizeSelect.value);

    const params = historyFilterParams();
    params.set("page", currentPage);
    params.set("pageSize", pageSize);

    const seq = ++requestSeq;
    const res = await fetch("/api/requests/history?" + params.toString());
    const data = await res.json();
    if (seq !== requestSeq) return; // a newer request has already landed

    const total = data.total;
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > totalPages) { currentPage = totalPages; return renderHistory(); }

    const startIdx = (currentPage - 1) * pageSize;
    const from = total === 0 ? 0 : startIdx + 1;
    const to = Math.min(startIdx + pageSize, total);

    document.getElementById("result-count").textContent = t("history.resultCount")
      .replace("{from}", from).replace("{to}", to).replace("{total}", total);
    document.getElementById("page-info").textContent = t("history.pageInfo")
      .replace("{page}", currentPage).replace("{pages}", totalPages);
    prevPageBtn.disabled = currentPage <= 1;
    nextPageBtn.disabled = currentPage >= totalPages;

    const tbody = document.getElementById("history-body");

    if (data.records.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="empty-state">' + t("history.empty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = data.records.map(function (r) {
      const categoryRow = UNIT_TYPES.find(function (c) { return c.nameTh === r.unitType; });
      const unitLabel = lang === "en" ? ((categoryRow && categoryRow.nameEn) || r.unitType) : r.unitType;
      const idLabel = r.runNumber ? (r.runNumber + " / " + r.referenceNo) : r.referenceNo;
      const officerLabel = r.handedOverByOfficer || r.reviewedByOfficer || "—";

      return '<tr data-ref="' + escapeHtml(r.referenceNo) + '">' +
        '<td>' + escapeHtml(idLabel) + '</td>' +
        '<td>' + escapeHtml(r.requesterName) + '</td>' +
        '<td>' + escapeHtml(unitLabel) + '</td>' +
        '<td>' + escapeHtml(r.itemList) + '</td>' +
        '<td>' + formatDateTime(new Date(r.submissionDate), lang) + '</td>' +
        '<td><span class="badge badge-' + escapeHtml(r.statusCode) + '">' + t("status." + r.statusCode) + '</span></td>' +
        '<td>' + escapeHtml(officerLabel) + '</td>' +
        '<td><a class="btn btn-secondary" style="padding:6px 12px; font-size:13px;" href="request-form-view?ref=' + encodeURIComponent(r.referenceNo) + '" target="_blank">' +
          '<span class="icon" data-icon="eye" style="width:14px; height:14px;"><%- icon('eye') %></span> ' + t("history.viewForm") +
        '</a></td>' +
        '</tr>';
    }).join("");

    tbody.querySelectorAll("tr[data-ref]").forEach(function (tr) {
      tr.style.cursor = "pointer";
      tr.addEventListener("click", function (e) {
        if (e.target.closest("a")) return;
        window.location.href = "/officer/request-detail?ref=" + encodeURIComponent(this.getAttribute("data-ref")) + "&from=history";
      });
    });

    applyIcons();
  }

  function onFilterChange() {
    currentPage = 1;
    renderHistory();
  }

  function onCustomRangeToggleChange() {
    const isCustom = customRangeToggle.checked;
    calendarFields.hidden = isCustom;
    customRangeFields.hidden = !isCustom;
    onFilterChange();
  }

  // One click undoes the whole custom range — clears both dates, unchecks
  // the toggle, and goes back to the plain Year/Month dropdowns — instead of
  // needing to clear each date field individually plus the checkbox.
  function clearCustomRange() {
    fromDateInput.value = "";
    toDateInput.value = "";
    customRangeToggle.checked = false;
    onCustomRangeToggleChange();
  }

  const onSearchInput = debounce(onFilterChange, 300);

  searchInput.addEventListener("input", onSearchInput);
  statusFilter.addEventListener("change", onFilterChange);
  unitFilter.addEventListener("change", onFilterChange);
  yearFilter.addEventListener("change", onFilterChange);
  monthFilter.addEventListener("change", onFilterChange);
  customRangeToggle.addEventListener("change", onCustomRangeToggleChange);
  customRangeClearBtn.addEventListener("click", clearCustomRange);

  // Collapsible filter panel (initFilterCollapse in app.js).
  initFilterCollapse({
    toggle: "history-filter-toggle", body: "history-filter-body", badge: "history-filter-count", key: "history",
    count: function () {
      let n = 0;
      if (statusFilter.value) n++;
      if (unitFilter.value) n++;
      if (customRangeToggle.checked ? (fromDateInput.value || toDateInput.value) : (yearFilter.value || monthFilter.value !== "")) n++;
      return n;
    }
  });
  fromDateInput.addEventListener("change", onFilterChange);
  toDateInput.addEventListener("change", onFilterChange);
  pageSizeSelect.addEventListener("change", onFilterChange);

  prevPageBtn.addEventListener("click", function () {
    currentPage -= 1;
    renderHistory();
  });
  nextPageBtn.addEventListener("click", function () {
    currentPage += 1;
    renderHistory();
  });

  document.addEventListener("odprs:langchange", function () {
    renderUnitFilterOptions();
    renderYearFilterOptions();
    renderMonthFilterOptions();
    renderHistory();
  });

  Promise.all([loadAvailableYears(), loadUnitTypes()]).then(function (results) {
    availableYears = results[0];
    UNIT_TYPES = results[1];
    renderUnitFilterOptions();
    renderYearFilterOptions();
    renderMonthFilterOptions();
    renderHistory();
  });
</script>
</body>
</html>
