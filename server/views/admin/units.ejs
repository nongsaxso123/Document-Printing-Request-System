<%- include("../partials/head", { title: "จัดการหน่วยงาน | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.adminUnits", crumbFallback: "หน่วยงาน / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="adminUnits.title">หน่วยงาน</h1>
    <p class="page-subtitle" data-i18n="adminUnits.subtitle">กำหนดประเภทหน่วยงานและหน่วยงานย่อยที่ผู้ขอเลือกตอนส่งคำขอ กรอกทั้งภาษาไทยและอังกฤษ</p>

    <div class="notice loc-banner" id="unit-banner" hidden>
      <span class="icon" id="unit-banner-icon" data-icon="check-circle"><%- icon('check-circle') %></span>
      <div id="unit-banner-text"></div>
    </div>

    <!-- ---------- category form (add/edit) ---------- -->
    <div class="card admin-card" id="category-form-card" hidden>
      <div class="card-header"><span id="category-form-title" data-i18n="adminUnits.categoryForm.addTitle">เพิ่มประเภทหน่วยงาน</span></div>
      <div class="card-body">
        <div class="notice notice-error" id="category-error" hidden>
          <span class="icon" data-icon="alert-triangle"><%- icon('alert-triangle') %></span>
          <div id="category-error-text"></div>
        </div>
        <form id="category-form" novalidate>
          <div class="form-grid">
            <div class="field" id="field-category-nameTh">
              <label data-i18n="adminUnits.form.nameTh">ชื่อ (ไทย) *</label>
              <input type="text" id="category-nameTh" placeholder="สำนักวิชา">
            </div>
            <div class="field" id="field-category-nameEn">
              <label data-i18n="adminUnits.form.nameEn">ชื่อ (อังกฤษ) *</label>
              <input type="text" id="category-nameEn" placeholder="School">
            </div>
          </div>
          <!-- Not offered when adding/editing a category from this admin
               form (the user's explicit choice — every new category should
               always have a fixed unit list). The checkbox stays in the DOM,
               hidden, purely so an existing free-text category (e.g.
               "หน่วยงานอื่นๆ") keeps its allowsFreeText flag intact when
               edited here for something else (name, sort order, etc.) —
               openCategoryForm() still sets .checked from the real value,
               it's just never shown or toggleable in this form anymore. -->
          <input type="checkbox" id="category-allowsFreeText" hidden>
          <div class="loc-actions">
            <button type="submit" class="btn btn-primary" id="category-save-btn" data-i18n="adminUnits.form.saveBtn">บันทึก</button>
            <button type="button" class="btn btn-secondary" id="category-cancel-btn" data-i18n="btn.cancel">ยกเลิก</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ---------- categories list ---------- -->
    <div class="card admin-card" id="categories-view">
      <div class="card-header">
        <span data-i18n="adminUnits.categoriesTitle">ประเภทหน่วยงาน</span>
        <button type="button" class="btn btn-primary btn-sm" id="add-category-btn">
          <span class="icon" data-icon="file-plus"><%- icon('file-plus') %></span>
          <span data-i18n="adminUnits.addCategoryBtn">เพิ่มประเภท</span>
        </button>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:84px;"></th>
              <th data-i18n="adminUnits.th.name">ประเภทหน่วยงาน</th>
              <th data-i18n="adminUnits.th.units">หน่วยงานย่อย</th>
              <th data-i18n="adminUnits.th.action">การดำเนินการ</th>
            </tr>
          </thead>
          <tbody id="category-table-body"></tbody>
        </table>
      </div>
    </div>

    <!-- ---------- unit form (add/edit) ---------- -->
    <div class="card admin-card" id="unit-form-card" hidden>
      <div class="card-header"><span id="unit-form-title" data-i18n="adminUnits.unitForm.addTitle">เพิ่มหน่วยงาน</span></div>
      <div class="card-body">
        <div class="notice notice-error" id="unit-error" hidden>
          <span class="icon" data-icon="alert-triangle"><%- icon('alert-triangle') %></span>
          <div id="unit-error-text"></div>
        </div>
        <form id="unit-form" novalidate>
          <div class="form-grid">
            <div class="field" id="field-unit-nameTh">
              <label data-i18n="adminUnits.form.nameTh">ชื่อ (ไทย) *</label>
              <input type="text" id="unit-nameTh" placeholder="สำนักวิชาศิลปศาสตร์">
            </div>
            <div class="field" id="field-unit-nameEn">
              <label data-i18n="adminUnits.form.nameEn">ชื่อ (อังกฤษ) *</label>
              <input type="text" id="unit-nameEn" placeholder="School of Liberal Arts">
            </div>
            <div class="field span-2">
              <label data-i18n="adminUnits.unitForm.category">ประเภทหน่วยงาน</label>
              <select id="unit-categoryId"></select>
              <span class="hint" data-i18n="adminUnits.unitForm.categoryHint">เปลี่ยนได้ถ้าต้องการย้ายหน่วยงานนี้ไปอีกประเภทหนึ่ง</span>
            </div>
          </div>
          <div class="loc-actions">
            <button type="submit" class="btn btn-primary" id="unit-save-btn" data-i18n="adminUnits.form.saveBtn">บันทึก</button>
            <button type="button" class="btn btn-secondary" id="unit-cancel-btn" data-i18n="btn.cancel">ยกเลิก</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ---------- units of one category (drill-down) ---------- -->
    <div class="card admin-card" id="units-view" hidden>
      <div class="card-header">
        <span class="units-view-head">
          <button type="button" class="btn btn-secondary btn-sm" id="back-to-categories-btn">‹ <span data-i18n="adminUnits.backBtn">ประเภทหน่วยงาน</span></button>
          <span class="units-view-heading">
            <span class="units-view-eyebrow" data-i18n="adminUnits.unitTypeLabel">ประเภทหน่วยงาน</span>
            <span class="units-view-title-row">
              <strong id="units-view-title"></strong>
              <span class="units-view-count" id="units-view-count"></span>
            </span>
          </span>
        </span>
        <button type="button" class="btn btn-primary btn-sm" id="add-unit-btn">
          <span class="icon" data-icon="file-plus"><%- icon('file-plus') %></span>
          <span data-i18n="adminUnits.addUnitBtn">เพิ่มหน่วยงาน</span>
        </button>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:84px;"></th>
              <th data-i18n="adminUnits.th.name">หน่วยงาน</th>
              <th data-i18n="adminUnits.th.action">การดำเนินการ</th>
            </tr>
          </thead>
          <tbody id="unit-table-body"></tbody>
        </table>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  const ERROR_KEYS = {
    "name-required": "adminUnits.err.nameRequired",
    "category-required": "adminUnits.err.categoryRequired",
    "category-invalid": "adminUnits.err.categoryInvalid",
    "last-category": "adminUnits.err.lastCategory",
    "last-freetext": "adminUnits.err.lastFreeText",
    "has-units": "adminUnits.err.hasUnits",
    "not-found": "adminUnits.err.generic"
  };

  const byId = function (id) { return document.getElementById(id); };
  const banner = byId("unit-banner");
  let bannerTimer = null;

  function escHtml(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  // Every save/archive/delete outcome is reported in the shared result
  // popup (showActionResult in app.js), like every other page.
  function showBanner(kind, text) {
    showActionResult(kind === "success", text);
  }

  function messageFor(error, data) {
    if (error === "in-use") return t("adminUnits.err.inUse").replace("{n}", data && data.count != null ? data.count : "");
    return t(ERROR_KEYS[error] || "adminUnits.err.generic");
  }

  async function postJson(url, body) {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body || {})
    });
    const data = await res.json().catch(function () { return {}; });
    return { ok: res.ok, data: data };
  }

  function nameOf(row) { return row ? pickLang(row.nameTh, row.nameEn) : ""; }

  // ==================== categories ====================

  let categoryList = [];

  const categoryFormCard = byId("category-form-card");
  const categoryForm = byId("category-form");
  const categoryErrorBox = byId("category-error");
  let editingCategoryId = null;

  // ---------- empty-field marking (both forms) ----------
  // Same behaviour as the Locations form: red outline + a red line with an
  // alert icon under each empty field, jump to the first one and focus it;
  // the mark clears as soon as that field gets typed in.
  const CATEGORY_FIELDS = ["field-category-nameTh", "field-category-nameEn"];
  const UNIT_FIELDS = ["field-unit-nameTh", "field-unit-nameEn"];

  function markFields(allIds, invalidIds) {
    const invalid = invalidIds || [];
    allIds.forEach(function (id) {
      const field = byId(id);
      field.classList.toggle("invalid", invalid.indexOf(id) !== -1);
      const old = field.querySelector(".loc-field-msg");
      if (old) old.remove();
      if (invalid.indexOf(id) !== -1) {
        const msg = document.createElement("span");
        msg.className = "field-error loc-field-msg";
        msg.setAttribute("role", "alert");
        msg.innerHTML = '<span class="icon">' + ICONS["alert-circle"] + '</span><span></span>';
        msg.lastElementChild.textContent = t("adminUnits.err.fillThis");
        field.appendChild(msg);
      }
    });
    if (invalid.length) {
      const first = byId(invalid[0]);
      first.scrollIntoView({ behavior: "smooth", block: "center" });
      const input = first.querySelector("input, select");
      if (input) input.focus({ preventScroll: true });
    }
  }

  CATEGORY_FIELDS.concat(UNIT_FIELDS).forEach(function (id) {
    byId(id).addEventListener("input", function () {
      byId(id).classList.remove("invalid");
      const msg = byId(id).querySelector(".loc-field-msg");
      if (msg) msg.remove();
    });
  });

  function clearCategoryError() {
    categoryErrorBox.hidden = true;
    markFields(CATEGORY_FIELDS, []);
  }

  function showCategoryError(message, invalidIds) {
    byId("category-error-text").textContent = message;
    categoryErrorBox.hidden = false;
    markFields(CATEGORY_FIELDS, invalidIds);
  }

  // Form titles are rebuilt here (not via data-i18n) because the edit title
  // carries the row's name; the langchange handler calls these again.
  function renderCategoryFormTitle() {
    const title = byId("category-form-title");
    title.removeAttribute("data-i18n");
    const category = editingCategoryId != null ? categoryList.find(function (c) { return c.id === editingCategoryId; }) : null;
    title.textContent = category
      ? t("adminUnits.categoryForm.editTitleNamed").replace("{name}", nameOf(category))
      : t("adminUnits.categoryForm.addTitle");
  }

  function renderUnitFormTitle() {
    const title = byId("unit-form-title");
    title.removeAttribute("data-i18n");
    const unit = editingUnitId != null ? unitList.find(function (u) { return u.id === editingUnitId; }) : null;
    title.textContent = unit
      ? t("adminUnits.unitForm.editTitleNamed").replace("{name}", nameOf(unit))
      : t("adminUnits.unitForm.addTitle");
  }

  // Leaving the page with an open, edited form asks first (guardUnsavedChanges in app.js).
  let categorySnap = null, unitSnap = null;
  guardUnsavedChanges(function () {
    return (categorySnap !== null && !categoryFormCard.hidden && formSnapshot(categoryForm) !== categorySnap) ||
      (unitSnap !== null && !unitFormCard.hidden && formSnapshot(unitForm) !== unitSnap);
  });

  function openCategoryForm(category) {
    clearCategoryError();
    hideBannerNow();
    editingCategoryId = category ? category.id : null;
    byId("category-nameTh").value = category ? category.nameTh : "";
    byId("category-nameEn").value = category ? category.nameEn : "";
    byId("category-allowsFreeText").checked = category ? category.allowsFreeText : false;

    renderCategoryFormTitle();

    returnCategoryRowId = category ? category.id : null;
    categoryFormCard.hidden = false;
    revealForm(categoryFormCard);
    byId("category-nameTh").focus({ preventScroll: true });
    categorySnap = formSnapshot(categoryForm);
  }

  // Guide the eye: open form → scroll to it and pulse its border; save or
  // cancel → scroll back to the row that was edited (only if it is off
  // screen) and, after a save, flash it.
  let returnCategoryRowId = null;
  let returnUnitRowId = null;

  function revealForm(card) {
    card.scrollIntoView({ behavior: "smooth", block: "start" });
    card.classList.remove("form-card-flash");
    void card.offsetWidth; // restart the animation on repeated clicks
    card.classList.add("form-card-flash");
  }

  // Scroll an element into view only when it's off screen (below the 64px
  // sticky header counts as off screen).
  function revealEl(el) {
    const rect = el.getBoundingClientRect();
    const headerH = 64;
    if (rect.top < headerH || rect.bottom > window.innerHeight) {
      el.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  // Cancel goes back where the user came from: the edited row, or the
  // "add" button when the form was opened to add something new.
  function returnAfterCancel(tbodyId, rowId, addBtnId) {
    if (rowId != null) return revealRow(tbodyId, rowId, false);
    revealEl(byId(addBtnId));
  }

  function revealRow(tbodyId, id, flash) {
    if (id == null) return;
    const row = byId(tbodyId).querySelector('tr[data-row-id="' + id + '"]');
    if (!row) return;
    revealEl(row);
    if (flash) {
      row.classList.remove("row-flash");
      void row.offsetWidth;
      row.classList.add("row-flash");
    }
  }

  function closeCategoryForm() {
    categoryFormCard.hidden = true;
    categorySnap = null;
    editingCategoryId = null;
    clearCategoryError();
  }

  function hideBannerNow() { banner.hidden = true; }

  async function loadCategories() {
    const res = await fetch("/api/admin/unit-types");
    categoryList = await res.json();
  }

  function renderCategoryTable() {
    const lang = getLang();
    const tbody = byId("category-table-body");

    if (categoryList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="empty-state">' + t("adminUnits.categoriesEmpty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = categoryList.map(function (c, index) {
      const badges = [];
      if (c.allowsFreeText) badges.push('<span class="badge badge-awaiting">' + t("adminUnits.badge.freeText") + '</span>');
      if (!c.isActive) badges.push('<span class="badge badge-cancelled">' + t("adminUnits.badge.archived") + '</span>');
      const unitsCell = c.allowsFreeText
        ? '<span class="hint">' + t("adminUnits.freeTextHint") + '</span>'
        : '<button type="button" class="btn btn-secondary btn-sm" data-view-units="' + c.id + '">' + t("adminUnits.viewUnitsBtn").replace("{n}", c.unitCount != null ? c.unitCount : "0") + '</button>';

      return '<tr data-row-id="' + c.id + '"' + (c.isActive ? "" : ' style="opacity:.6;"') + '>' +
        '<td style="white-space:nowrap;">' +
          '<span class="row-move">' +
            '<button type="button" class="btn" data-move="up" data-id="' + c.id + '" title="' + t("adminLocations.moveUp") + '"' + (index === 0 ? " disabled" : "") + '>↑</button>' +
            '<button type="button" class="btn" data-move="down" data-id="' + c.id + '" title="' + t("adminLocations.moveDown") + '"' + (index === categoryList.length - 1 ? " disabled" : "") + '>↓</button>' +
          '</span>' +
        '</td>' +
        '<td>' + escHtml(pickLang(c.nameTh, c.nameEn, lang)) + ' ' + badges.join(" ") + '</td>' +
        '<td>' + unitsCell + '</td>' +
        '<td style="white-space:nowrap;">' +
          '<span class="row-actions">' +
            '<button type="button" class="btn btn-secondary btn-sm" data-edit="' + c.id + '">' + t("adminUnits.editBtn") + '</button>' +
            (c.isActive
              ? '<button type="button" class="btn btn-secondary btn-sm" data-archive="' + c.id + '">' + t("adminUnits.archiveBtn") + '</button>'
              : '<button type="button" class="btn btn-secondary btn-sm" data-restore="' + c.id + '">' + t("adminUnits.restoreBtn") + '</button>') +
            '<button type="button" class="btn btn-danger btn-sm" data-delete="' + c.id + '">' + t("adminUnits.deleteBtn") + '</button>' +
          '</span>' +
        '</td>' +
        '</tr>';
    }).join("");
  }

  async function refreshCategories(flashId) {
    await loadCategories();
    renderCategoryTable();
    if (flashId) revealRow("category-table-body", flashId, true);
  }

  categoryForm.addEventListener("submit", async function (e) {
    e.preventDefault();
    clearCategoryError();

    const payload = {
      nameTh: byId("category-nameTh").value,
      nameEn: byId("category-nameEn").value,
      allowsFreeText: byId("category-allowsFreeText").checked
    };
    const missing = [];
    if (!payload.nameTh.trim()) missing.push("field-category-nameTh");
    if (!payload.nameEn.trim()) missing.push("field-category-nameEn");
    if (missing.length) return showCategoryError(t("adminUnits.err.nameRequired"), missing);

    const saveBtn = byId("category-save-btn");
    const idleLabel = saveBtn.textContent;
    saveBtn.disabled = true;
    saveBtn.textContent = t("btn.saving");
    const result = await postJson(editingCategoryId ? "/api/admin/unit-types/" + editingCategoryId : "/api/admin/unit-types", payload);
    saveBtn.disabled = false;
    saveBtn.textContent = idleLabel;

    if (!result.ok) {
      showCategoryError(messageFor(result.data.error, result.data), []);
      return showBanner("error", messageFor(result.data.error, result.data));
    }

    const savedId = result.data.id;
    closeCategoryForm();
    await refreshCategories(savedId);
    showBanner("success", t("adminUnits.banner.saved").replace("{name}", nameOf(result.data)));
  });

  byId("add-category-btn").addEventListener("click", function () { openCategoryForm(null); });
  byId("category-cancel-btn").addEventListener("click", function () {
    closeCategoryForm();
    returnAfterCancel("category-table-body", returnCategoryRowId, "add-category-btn");
  });

  async function setCategoryActive(id, isActive) {
    const category = categoryList.find(function (c) { return c.id === id; });
    const result = await postJson("/api/admin/unit-types/" + id + "/active", { isActive: isActive });
    if (!result.ok) return showBanner("error", messageFor(result.data.error, result.data));
    await refreshCategories(id);
    showBanner("success", t(isActive ? "adminUnits.banner.restored" : "adminUnits.banner.archived").replace("{name}", nameOf(category)));
  }

  async function deleteCategory(id) {
    const category = categoryList.find(function (c) { return c.id === id; });
    const result = await postJson("/api/admin/unit-types/" + id + "/delete");
    if (!result.ok) return showBanner("error", messageFor(result.data.error, result.data));
    await refreshCategories();
    showBanner("success", t("adminUnits.banner.deleted").replace("{name}", nameOf(category)));
  }

  byId("category-table-body").addEventListener("click", async function (e) {
    const btn = e.target.closest("button");
    if (!btn || btn.disabled) return;

    if (btn.hasAttribute("data-view-units")) {
      return showUnitsView(Number(btn.getAttribute("data-view-units")));
    }
    if (btn.hasAttribute("data-edit")) {
      const category = categoryList.find(function (c) { return c.id === Number(btn.getAttribute("data-edit")); });
      return openCategoryForm(category);
    }
    if (btn.hasAttribute("data-restore")) return setCategoryActive(Number(btn.getAttribute("data-restore")), true);

    if (btn.hasAttribute("data-move")) {
      const result = await postJson("/api/admin/unit-types/" + btn.getAttribute("data-id") + "/move", { direction: btn.getAttribute("data-move") });
      if (result.ok) { categoryList = result.data; renderCategoryTable(); }
      return;
    }

    if (btn.hasAttribute("data-archive")) {
      const id = Number(btn.getAttribute("data-archive"));
      const category = categoryList.find(function (c) { return c.id === id; });
      return showConfirmModal({
        title: t("adminUnits.archiveConfirmTitle"),
        message: t("adminUnits.archiveConfirmMessage").replace("{name}", nameOf(category)),
        confirmText: t("adminUnits.archiveBtn"),
        danger: true,
        onConfirm: function () { return setCategoryActive(id, false); }
      });
    }

    if (btn.hasAttribute("data-delete")) {
      const id = Number(btn.getAttribute("data-delete"));
      const category = categoryList.find(function (c) { return c.id === id; });
      return showConfirmModal({
        title: t("adminUnits.deleteConfirmTitle"),
        message: t("adminUnits.deleteConfirmMessage").replace("{name}", nameOf(category)),
        confirmText: t("adminUnits.deleteBtn"),
        danger: true,
        onConfirm: function () { return deleteCategory(id); }
      });
    }
  });

  // ==================== units (drill-down into one category) ====================

  let currentCategoryId = null;
  let unitList = [];

  const unitFormCard = byId("unit-form-card");
  const unitForm = byId("unit-form");
  const unitErrorBox = byId("unit-error");
  let editingUnitId = null;

  function clearUnitError() {
    unitErrorBox.hidden = true;
    markFields(UNIT_FIELDS, []);
  }

  function showUnitError(message, invalidIds) {
    byId("unit-error-text").textContent = message;
    unitErrorBox.hidden = false;
    markFields(UNIT_FIELDS, invalidIds);
  }

  function fillUnitCategorySelect(selectedId) {
    const select = byId("unit-categoryId");
    const lang = getLang();
    select.innerHTML = "";
    categoryList.filter(function (c) { return !c.allowsFreeText; }).forEach(function (c) {
      const opt = document.createElement("option");
      opt.value = String(c.id);
      opt.textContent = pickLang(c.nameTh, c.nameEn, lang);
      select.appendChild(opt);
    });
    select.value = String(selectedId);
  }

  function openUnitForm(unit) {
    clearUnitError();
    hideBannerNow();
    editingUnitId = unit ? unit.id : null;
    byId("unit-nameTh").value = unit ? unit.nameTh : "";
    byId("unit-nameEn").value = unit ? unit.nameEn : "";
    fillUnitCategorySelect(unit ? unit.categoryId : currentCategoryId);

    renderUnitFormTitle();

    returnUnitRowId = unit ? unit.id : null;
    unitFormCard.hidden = false;
    revealForm(unitFormCard);
    byId("unit-nameTh").focus({ preventScroll: true });
    unitSnap = formSnapshot(unitForm);
  }

  function closeUnitForm() {
    unitFormCard.hidden = true;
    unitSnap = null;
    editingUnitId = null;
    clearUnitError();
  }

  async function loadUnits(categoryId) {
    const res = await fetch("/api/admin/unit-types/" + categoryId + "/units");
    unitList = await res.json();
  }

  // Heading of the drill-down: the category name on its own (big), a small
  // "Unit Type" label above it and the unit count beside it.
  function renderUnitsTitle() {
    const category = categoryList.find(function (c) { return c.id === currentCategoryId; });
    byId("units-view-title").textContent = category ? nameOf(category) : "";
    byId("units-view-count").textContent = t("adminUnits.unitCount").replace("{n}", unitList.length);
  }

  function renderUnitTable() {
    renderUnitsTitle();
    const lang = getLang();
    const tbody = byId("unit-table-body");

    if (unitList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="3" class="empty-state">' + t("adminUnits.unitsEmpty") + '</td></tr>';
      return;
    }

    tbody.innerHTML = unitList.map(function (u, index) {
      const badges = !u.isActive ? ' <span class="badge badge-cancelled">' + t("adminUnits.badge.archived") + '</span>' : "";
      return '<tr data-row-id="' + u.id + '"' + (u.isActive ? "" : ' style="opacity:.6;"') + '>' +
        '<td style="white-space:nowrap;">' +
          '<span class="row-move">' +
            '<button type="button" class="btn" data-move="up" data-id="' + u.id + '" title="' + t("adminLocations.moveUp") + '"' + (index === 0 ? " disabled" : "") + '>↑</button>' +
            '<button type="button" class="btn" data-move="down" data-id="' + u.id + '" title="' + t("adminLocations.moveDown") + '"' + (index === unitList.length - 1 ? " disabled" : "") + '>↓</button>' +
          '</span>' +
        '</td>' +
        '<td>' + escHtml(pickLang(u.nameTh, u.nameEn, lang)) + badges + '</td>' +
        '<td style="white-space:nowrap;">' +
          '<span class="row-actions">' +
            '<button type="button" class="btn btn-secondary btn-sm" data-edit="' + u.id + '">' + t("adminUnits.editBtn") + '</button>' +
            (u.isActive
              ? '<button type="button" class="btn btn-secondary btn-sm" data-archive="' + u.id + '">' + t("adminUnits.archiveBtn") + '</button>'
              : '<button type="button" class="btn btn-secondary btn-sm" data-restore="' + u.id + '">' + t("adminUnits.restoreBtn") + '</button>') +
            '<button type="button" class="btn btn-danger btn-sm" data-delete="' + u.id + '">' + t("adminUnits.deleteBtn") + '</button>' +
          '</span>' +
        '</td>' +
        '</tr>';
    }).join("");
  }

  async function refreshUnits(flashId) {
    await loadUnits(currentCategoryId);
    renderUnitTable();
    if (flashId) revealRow("unit-table-body", flashId, true);
  }

  async function showUnitsView(categoryId) {
    currentCategoryId = categoryId;
    closeCategoryForm();
    hideBannerNow();
    byId("categories-view").hidden = true;
    byId("units-view").hidden = false;
    unitList = [];
    renderUnitsTitle();
    await refreshUnits();
  }

  function showCategoriesView() {
    currentCategoryId = null;
    closeUnitForm();
    hideBannerNow();
    byId("units-view").hidden = true;
    byId("categories-view").hidden = false;
  }

  byId("back-to-categories-btn").addEventListener("click", showCategoriesView);
  byId("add-unit-btn").addEventListener("click", function () { openUnitForm(null); });
  byId("unit-cancel-btn").addEventListener("click", function () {
    closeUnitForm();
    returnAfterCancel("unit-table-body", returnUnitRowId, "add-unit-btn");
  });

  unitForm.addEventListener("submit", async function (e) {
    e.preventDefault();
    clearUnitError();

    const payload = {
      nameTh: byId("unit-nameTh").value,
      nameEn: byId("unit-nameEn").value,
      categoryId: byId("unit-categoryId").value
    };
    const missing = [];
    if (!payload.nameTh.trim()) missing.push("field-unit-nameTh");
    if (!payload.nameEn.trim()) missing.push("field-unit-nameEn");
    if (missing.length) return showUnitError(t("adminUnits.err.nameRequired"), missing);

    const saveBtn = byId("unit-save-btn");
    const idleLabel = saveBtn.textContent;
    saveBtn.disabled = true;
    saveBtn.textContent = t("btn.saving");
    const result = await postJson(editingUnitId ? "/api/admin/units/" + editingUnitId : "/api/admin/units", payload);
    saveBtn.disabled = false;
    saveBtn.textContent = idleLabel;

    if (!result.ok) {
      showUnitError(messageFor(result.data.error, result.data), []);
      return showBanner("error", messageFor(result.data.error, result.data));
    }

    closeUnitForm();
    // A unit moved to a different category no longer belongs in this list.
    const movedAway = result.data.categoryId !== currentCategoryId;
    if (movedAway) {
      await refreshCategories();
      showUnitsView(result.data.categoryId);
    } else {
      await refreshUnits(result.data.id);
    }
    showBanner("success", t("adminUnits.banner.saved").replace("{name}", nameOf(result.data)));
  });

  async function setUnitActive(id, isActive) {
    const unit = unitList.find(function (u) { return u.id === id; });
    const result = await postJson("/api/admin/units/" + id + "/active", { isActive: isActive });
    if (!result.ok) return showBanner("error", messageFor(result.data.error, result.data));
    await refreshUnits(id);
    showBanner("success", t(isActive ? "adminUnits.banner.restored" : "adminUnits.banner.archived").replace("{name}", nameOf(unit)));
  }

  async function deleteUnit(id) {
    const unit = unitList.find(function (u) { return u.id === id; });
    const result = await postJson("/api/admin/units/" + id + "/delete");
    if (!result.ok) return showBanner("error", messageFor(result.data.error, result.data));
    await refreshUnits();
    await loadCategories(); // unit count on the categories table changed
    showBanner("success", t("adminUnits.banner.deleted").replace("{name}", nameOf(unit)));
  }

  byId("unit-table-body").addEventListener("click", async function (e) {
    const btn = e.target.closest("button");
    if (!btn || btn.disabled) return;

    if (btn.hasAttribute("data-edit")) {
      const unit = unitList.find(function (u) { return u.id === Number(btn.getAttribute("data-edit")); });
      return openUnitForm(unit);
    }
    if (btn.hasAttribute("data-restore")) return setUnitActive(Number(btn.getAttribute("data-restore")), true);

    if (btn.hasAttribute("data-move")) {
      const result = await postJson("/api/admin/units/" + btn.getAttribute("data-id") + "/move", { direction: btn.getAttribute("data-move") });
      if (result.ok) await refreshUnits();
      return;
    }

    if (btn.hasAttribute("data-archive")) {
      const id = Number(btn.getAttribute("data-archive"));
      const unit = unitList.find(function (u) { return u.id === id; });
      return showConfirmModal({
        title: t("adminUnits.archiveConfirmTitle"),
        message: t("adminUnits.archiveConfirmMessage").replace("{name}", nameOf(unit)),
        confirmText: t("adminUnits.archiveBtn"),
        danger: true,
        onConfirm: function () { return setUnitActive(id, false); }
      });
    }

    if (btn.hasAttribute("data-delete")) {
      const id = Number(btn.getAttribute("data-delete"));
      const unit = unitList.find(function (u) { return u.id === id; });
      return showConfirmModal({
        title: t("adminUnits.deleteConfirmTitle"),
        message: t("adminUnits.deleteConfirmMessage").replace("{name}", nameOf(unit)),
        confirmText: t("adminUnits.deleteBtn"),
        danger: true,
        onConfirm: function () { return deleteUnit(id); }
      });
    }
  });

  document.addEventListener("odprs:langchange", function () {
    renderCategoryTable();
    if (currentCategoryId) {
      renderUnitTable();
    }
    if (!categoryFormCard.hidden) renderCategoryFormTitle();
    if (!unitFormCard.hidden) {
      renderUnitFormTitle();
      // The category <select> inside the unit form shows names in the old language too.
      const select = byId("unit-categoryId");
      fillUnitCategorySelect(Number(select.value) || currentCategoryId);
    }
  });

  refreshCategories();
</script>
