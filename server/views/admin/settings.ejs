<%- include("../partials/head", { title: "การตั้งค่าระบบ | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.systemSettings", crumbFallback: "จัดการระบบ / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="settings.title">จัดการระบบ</h1>
    <p class="page-subtitle" data-i18n="settings.subtitle">แจ้งเตือนอีเมลเจ้าหน้าที่ และเปิด/ปิดระบบสำหรับผู้ขอ</p>

    <form id="settings-form">
      <div class="card admin-card">
        <div class="card-header"><span data-i18n="settings.notif.title">แจ้งเตือนเจ้าหน้าที่</span></div>
        <div class="card-body">
          <label class="set-row">
            <span class="set-row-text">
              <span class="set-row-title" data-i18n="settings.notif.toggle">ส่งอีเมลเมื่อมีคำขอใหม่</span>
              <span class="set-row-desc" data-i18n="settings.notif.toggle.hint">การแจ้งเตือนในระบบ (กระดิ่ง) ทำงานเสมอ</span>
            </span>
            <input type="checkbox" class="switch" id="officer-email-toggle" <%= settings.officerEmailNotificationsEnabled ? "checked" : "" %>>
          </label>
        </div>
      </div>

      <div class="card admin-card card-overflow-visible">
        <div class="card-header"><span data-i18n="settings.maint.title">ปิดระบบชั่วคราว</span></div>
        <div class="card-body">
          <label class="set-row">
            <span class="set-row-text">
              <span class="set-row-title" data-i18n="settings.maint.toggle">ปิดระบบสำหรับผู้ขอ</span>
              <span class="set-row-desc" data-i18n="settings.maint.toggle.hint">เจ้าหน้าที่และผู้ดูแลระบบยังใช้งานได้ตามปกติ</span>
            </span>
            <input type="checkbox" class="switch switch-danger" id="maintenance-toggle" <%= settings.maintenanceModeEnabled ? "checked" : "" %>>
          </label>

          <!-- Schedule + messages only matter while the switch is on: they
               slide open when it's ticked and fold away when it isn't
               (values are kept either way). See setMaintDetails(). -->
          <div class="set-collapse<%= settings.maintenanceModeEnabled ? " is-open" : "" %>" id="maint-details">
          <div class="set-divider"></div>

          <div class="set-subtitle" data-i18n="settings.maint.scheduleTitle">ช่วงเวลาปิดระบบ (ไม่บังคับ)</div>
          <div class="set-pair">
            <div class="field" id="maintenance-start-field">
              <label data-i18n="settings.maint.startLabel">ปิดระบบตั้งแต่</label>
              <div class="set-datetime">
                <%- include("../partials/date-picker", { id: "maintenance-start-date", name: "maintenanceStartDate" }) %>
                <%- include("../partials/time-wheel", { id: "maintenance-start-time" }) %>
              </div>
            </div>
            <div class="field" id="maintenance-end-field">
              <label data-i18n="settings.maint.endLabel">เปิดระบบอีกครั้ง</label>
              <div class="set-datetime">
                <%- include("../partials/date-picker", { id: "maintenance-end-date", name: "maintenanceEndDate" }) %>
                <%- include("../partials/time-wheel", { id: "maintenance-end-time" }) %>
              </div>
              <span class="field-error" id="maintenance-end-error"></span>
            </div>
          </div>
          <!-- Status line ("closed from … to …") with the one "clear dates"
               button at its right end; the button clears start + end together
               and only shows while either end has a date. -->
          <div class="set-schedule-status" id="maintenance-status-box">
            <span class="set-schedule-status-text" id="maintenance-status"></span>
            <button type="button" class="btn btn-secondary" id="maintenance-clear-all" data-i18n="settings.maint.clearAllBtn" hidden>ล้างช่วงเวลา</button>
          </div>

          <div class="set-divider"></div>

          <div class="set-subtitle" data-i18n="settings.maint.messagesTitle">ข้อความแจ้งผู้ขอ (ไม่บังคับ)</div>
          <div class="set-pair">
            <div class="field">
              <label for="maintenance-message" data-i18n="settings.maint.messageLabel">ภาษาไทย</label>
              <textarea id="maintenance-message" rows="3" data-i18n-placeholder="settings.maint.messagePlaceholder" placeholder="เช่น ปิดรับคำขอช่วงสอบปลายภาค 1–15 ต.ค. 2569"><%= settings.maintenanceMessage || "" %></textarea>
            </div>
            <div class="field">
              <label for="maintenance-message-en" data-i18n="settings.maint.messageEnLabel">ภาษาอังกฤษ</label>
              <textarea id="maintenance-message-en" rows="3" data-i18n-placeholder="settings.maint.messageEnPlaceholder" placeholder="เว้นว่าง = แปลอัตโนมัติ"><%= settings.maintenanceMessageEn || "" %></textarea>
              <span class="hint" data-i18n="settings.maint.translateHint">เว้นว่างไว้ ระบบจะแปลจากภาษาไทยให้อัตโนมัติเมื่อบันทึก</span>
            </div>
          </div>
          </div>
        </div>
      </div>

      <div class="card admin-card">
        <div class="card-header"><span data-i18n="settings.contact.title">ข้อมูลติดต่อฝ่ายทะเบียน</span></div>
        <div class="card-body">
          <p class="set-row-desc" style="margin:0 0 12px;" data-i18n="settings.contact.hint">แสดงใต้กล่องเข้าสู่ระบบ เว้นว่างทั้งสองช่องถ้าไม่ต้องการแสดง</p>
          <div class="form-grid">
            <div class="field">
              <label data-i18n="settings.contact.phone">เบอร์โทรศัพท์</label>
              <input type="text" id="contact-phone" maxlength="300" value="<%= settings.contactPhone || "" %>" placeholder="(+66) 0 5391 6433, (+66) 0 5391 6546">
            </div>
            <div class="field" id="contact-email-field">
              <label data-i18n="settings.contact.email">อีเมล</label>
              <input type="text" id="contact-email" maxlength="200" value="<%= settings.contactEmail || "" %>" placeholder="edu.reg@mfu.ac.th">
              <span class="field-error" data-i18n="settings.contact.emailError">รูปแบบอีเมลไม่ถูกต้อง</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Sticky save bar: pinned to the bottom of the screen however far the
           page is scrolled. Quiet while nothing has changed; turns into a
           highlighted "unsaved changes" bar with an active Save button as
           soon as any field differs from what's saved. -->
      <div class="savebar" id="savebar" data-state="clean">
        <div class="savebar-status">
          <span class="savebar-icon icon" id="savebar-icon" aria-hidden="true"></span>
          <span class="savebar-text" id="savebar-text"></span>
        </div>
        <div class="savebar-actions">
          <button type="button" class="btn btn-secondary" id="discard-btn" data-i18n="settings.bar.discard" hidden>ยกเลิกการเปลี่ยนแปลง</button>
          <svg id="save-status-icon" class="save-status-icon" viewBox="0 0 36 36" width="22" height="22" hidden style="display:none;" aria-hidden="true">
            <circle id="save-status-ring" class="save-status-ring" cx="18" cy="18" r="14" fill="none" stroke-width="3"></circle>
            <path id="save-status-check" class="save-status-check" pathLength="24" d="M9 19l6 6 12-13" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <button type="submit" class="btn btn-primary savebar-save" id="save-btn" data-i18n="settings.saveBtn" disabled>บันทึกการตั้งค่า</button>
        </div>
      </div>
    </form>
  </main>

<%- include("../partials/foot") %>
<script>
  const form = document.getElementById("settings-form");
  const officerEmailToggle = document.getElementById("officer-email-toggle");
  const maintenanceToggle = document.getElementById("maintenance-toggle");
  const maintenanceMessage = document.getElementById("maintenance-message");
  const maintenanceMessageEn = document.getElementById("maintenance-message-en");
  const maintenanceEndField = document.getElementById("maintenance-end-field");
  const maintenanceEndError = document.getElementById("maintenance-end-error");
  const maintenanceStatus = document.getElementById("maintenance-status");
  const saveBtn = document.getElementById("save-btn");
  const saveStatusIcon = document.getElementById("save-status-icon");
  const saveStatusRing = document.getElementById("save-status-ring");
  const saveStatusCheck = document.getElementById("save-status-check");

  let maintenanceWasOn = maintenanceToggle.checked;
  let saveStatusResetTimer = null;

  // Each end of the closing window is a date (the shared Thai/Buddhist-year
  // picker) plus a 24-hour time wheel (partials/time-wheel.ejs) —
  // <input type="datetime-local"> shows AM/PM on most machines and can't be
  // forced to 24h. An empty date means "now" (start) / "until switched off" (end).
  const DEFAULT_TIME = "08:00";

  function createDateTimeControl(prefix, placeholderKey) {
    const picker = createDatePicker(document.getElementById(prefix + "-date"), {
      minDate: new Date(),
      placeholderKey: placeholderKey,
      onChange: function () { sync(); onScheduleChange(); }
    });
    const timeWheel = createTimeWheel(document.getElementById(prefix + "-time"), {
      value: DEFAULT_TIME,
      minuteStep: 5,
      onChange: function () { onScheduleChange(); }
    });

    function sync() {
      const hasDate = !!picker.getDate();
      timeWheel.setDisabled(!hasDate);
      syncClearAll();
    }

    function set(iso) {
      const d = iso ? new Date(iso) : null;
      picker.setDate(d);
      timeWheel.set(d ? String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0") : DEFAULT_TIME);
      sync();
    }

    function get() {
      const day = picker.getDate();
      if (!day) return null;
      const [h, m] = timeWheel.get().split(":").map(Number);
      return new Date(day.getFullYear(), day.getMonth(), day.getDate(), h, m);
    }

    return { get: get, set: set };
  }

  const maintenanceStart = createDateTimeControl("maintenance-start", "settings.maint.startPlaceholder");
  const maintenanceEnd = createDateTimeControl("maintenance-end", "settings.maint.endPlaceholder");

  function setScheduleInputs(startIso, endIso) {
    maintenanceStart.set(startIso);
    maintenanceEnd.set(endIso);
  }

  // Single "clear" for the whole window: empties both dates (and resets their
  // times) in one click. Only shown while at least one date is filled in.
  // (sync() first runs from the setScheduleInputs() call just below, after
  // both controls and this button exist.)
  const clearAllBtn = document.getElementById("maintenance-clear-all");
  function syncClearAll() {
    clearAllBtn.hidden = !maintenanceStart.get() && !maintenanceEnd.get();
  }
  clearAllBtn.addEventListener("click", function () {
    setScheduleInputs(null, null);
    onScheduleChange();
  });
  setScheduleInputs(<%- safeJson(settings.maintenanceStartsAt || null) %>, <%- safeJson(settings.maintenanceEndsAt || null) %>);

  // One-line summary under the date fields of what the current form values
  // would mean for Requesters (mirrors settings.isMaintenanceActive()).
  function renderMaintenanceStatus() {
    const lang = getLang();
    const start = maintenanceStart.get();
    const end = maintenanceEnd.get();
    const now = new Date();
    let key;
    if (!maintenanceToggle.checked) key = "off";
    else if (end && end <= now) key = "ended";
    else if (start && start > now) key = end ? "scheduled" : "scheduledOpenEnded";
    else key = end ? "closedUntil" : "closedIndefinitely";
    maintenanceStatus.textContent = t("settings.maint.status." + key)
      .replace("{start}", start ? formatDateTime(start, lang) : "")
      .replace("{end}", end ? formatDateTime(end, lang) : "");
    document.getElementById("maintenance-status-box").dataset.state = key;
  }

  function clearEndError() {
    maintenanceEndField.classList.remove("invalid");
  }

  function showEndError(key) {
    maintenanceEndError.textContent = t(key);
    maintenanceEndField.classList.add("invalid");
  }

  // Same checks the server makes (api.js), so the admin sees them before saving.
  function validateSchedule() {
    clearEndError();
    const start = maintenanceStart.get();
    const end = maintenanceEnd.get();
    if (start && end && end <= start) { showEndError("settings.maint.err.endBeforeStart"); return false; }
    if (maintenanceToggle.checked && end && end <= new Date()) { showEndError("settings.maint.err.endInPast"); return false; }
    return true;
  }

  function onScheduleChange() {
    clearEndError();
    renderMaintenanceStatus();
    updateSaveBar(); // date pickers / the clear button don't fire form input events
  }
  maintenanceToggle.addEventListener("change", onScheduleChange);

  // Slide the schedule/messages block open or shut with the switch. Height
  // is animated in px (CSS can't transition height:auto); once open it goes
  // back to auto + overflow visible so the calendar popup isn't clipped.
  const maintDetails = document.getElementById("maint-details");
  let maintDetailsTimer = null;
  // Scrolls (smoothly, alongside the slide) so the block that's opening is
  // fully on screen — above the sticky save bar — without pushing the switch
  // itself up under the top bar. Uses the final height, so it doesn't wait
  // for the slide to finish.
  function revealMaintDetails(targetHeight) {
    const header = document.querySelector(".app-header");
    const topLimit = (header ? header.getBoundingClientRect().bottom : 0) + 12;
    const bottomLimit = window.innerHeight - (saveBar.offsetHeight + 16) - 12;
    const top = maintDetails.getBoundingClientRect().top;
    const overflow = top + targetHeight - bottomLimit;
    if (overflow <= 0) return;
    // Don't scroll the switch row (just above the block) out of sight.
    const switchTop = maintenanceToggle.closest(".set-row").getBoundingClientRect().top;
    const by = Math.min(overflow, switchTop - topLimit);
    if (by > 0) window.scrollBy({ top: by, behavior: "smooth" });
  }

  function setMaintDetails(open, scroll) {
    if (maintDetails.classList.contains("is-open") === open) return;
    clearTimeout(maintDetailsTimer);
    maintDetails.classList.remove("is-settled");
    maintDetails.style.height = maintDetails.offsetHeight + "px";
    void maintDetails.offsetHeight;
    maintDetails.classList.toggle("is-open", open);
    const targetHeight = open ? maintDetails.scrollHeight : 0;
    maintDetails.style.height = targetHeight + "px";
    if (open && scroll) revealMaintDetails(targetHeight);
    maintDetailsTimer = setTimeout(function () {
      maintDetails.style.height = "";
      if (open) maintDetails.classList.add("is-settled");
      // Second pass: near the end of the page the document wasn't tall
      // enough yet for the first scroll to go all the way.
      if (open && scroll) revealMaintDetails(maintDetails.offsetHeight);
    }, 320);
  }
  if (maintDetails.classList.contains("is-open")) maintDetails.classList.add("is-settled");
  maintenanceToggle.addEventListener("change", function () { setMaintDetails(maintenanceToggle.checked, true); });
  document.addEventListener("odprs:langchange", renderMaintenanceStatus);
  document.addEventListener("DOMContentLoaded", renderMaintenanceStatus);

  // ---- Unsaved-changes tracking for the sticky save bar ----
  // savedState = what's in the DB right now; the bar compares the form to it
  // on every edit, so undoing an edit by hand also returns it to "clean".
  const contactPhoneInput = document.getElementById("contact-phone");
  const contactEmailInput = document.getElementById("contact-email");
  const saveBar = document.getElementById("savebar");
  const saveBarIcon = document.getElementById("savebar-icon");
  const saveBarText = document.getElementById("savebar-text");
  const discardBtn = document.getElementById("discard-btn");
  let saving = false;
  let justSaved = false;

  function readForm() {
    const start = maintenanceStart.get();
    const end = maintenanceEnd.get();
    return {
      officerEmail: officerEmailToggle.checked,
      maintenance: maintenanceToggle.checked,
      start: start ? start.toISOString() : null,
      end: end ? end.toISOString() : null,
      message: maintenanceMessage.value,
      messageEn: maintenanceMessageEn.value,
      phone: contactPhoneInput.value,
      email: contactEmailInput.value
    };
  }
  let savedState = readForm();

  function isDirty() {
    return JSON.stringify(readForm()) !== JSON.stringify(savedState);
  }

  function updateSaveBar() {
    const dirty = isDirty();
    if (dirty) justSaved = false;
    const state = saving ? "saving" : dirty ? "dirty" : justSaved ? "saved" : "clean";
    saveBar.dataset.state = state;
    saveBarIcon.innerHTML = ICONS[state === "dirty" ? "alert-triangle" : state === "saving" ? "clock" : "check-circle"] || "";
    saveBarText.textContent = t("settings.bar." + state);
    saveBtn.disabled = saving || !dirty;
    discardBtn.hidden = saving || !dirty;
  }

  function discardChanges() {
    officerEmailToggle.checked = savedState.officerEmail;
    maintenanceToggle.checked = savedState.maintenance;
    setMaintDetails(savedState.maintenance);
    setScheduleInputs(savedState.start, savedState.end);
    maintenanceMessage.value = savedState.message;
    maintenanceMessageEn.value = savedState.messageEn;
    contactPhoneInput.value = savedState.phone;
    contactEmailInput.value = savedState.email;
    clearEndError();
    document.getElementById("contact-email-field").classList.remove("invalid");
    renderMaintenanceStatus();
    updateSaveBar();
  }

  // "input" covers typing, "change" covers switches/selects; the date
  // pickers report through onScheduleChange().
  form.addEventListener("input", updateSaveBar);
  form.addEventListener("change", updateSaveBar);
  discardBtn.addEventListener("click", discardChanges);
  document.addEventListener("odprs:langchange", updateSaveBar);
  updateSaveBar();

  // Leaving the page with unsaved edits asks first: the app's own dialog
  // for links, the browser's prompt for reload / close tab / back
  // (see guardUnsavedChanges in app.js).
  guardUnsavedChanges(function () { return !saving && isDirty(); }, "settings.leaveTitle");

  // App Store "install" style feedback: a spinning ring while the request
  // is in flight (translation can take a couple of seconds — see
  // translate.js), morphing into a drawn-in checkmark once it succeeds.
  function hideSaveIcon() {
    saveStatusIcon.hidden = true;
    saveStatusIcon.style.display = "none"; // explicit, on top of [hidden] — never show on plain page load
  }

  function showSaveSpinner() {
    clearTimeout(saveStatusResetTimer);
    saving = true;
    updateSaveBar();
    saveStatusIcon.hidden = false;
    saveStatusIcon.style.display = "";
    saveStatusRing.style.display = "";
    saveStatusCheck.classList.remove("drawn");
    saveStatusCheck.style.display = "none";
  }

  function showSaveCheckmark() {
    saveStatusRing.style.display = "none";
    saveStatusCheck.style.display = "";
    void saveStatusCheck.getBoundingClientRect(); // restart the draw animation on repeat saves
    saveStatusCheck.classList.add("drawn");
    saveStatusResetTimer = setTimeout(function () {
      hideSaveIcon();
      justSaved = false;
      updateSaveBar();
    }, 4000);
  }

  function endSaving() {
    hideSaveIcon();
    saving = false;
    updateSaveBar();
  }

  async function saveSettings() {
    showSaveSpinner();
    let res, updated;
    try {
      res = await fetch("/api/admin/settings/system", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          officerEmailNotificationsEnabled: officerEmailToggle.checked,
          maintenanceModeEnabled: maintenanceToggle.checked,
          maintenanceStartsAt: maintenanceStart.get() ? maintenanceStart.get().toISOString() : null,
          maintenanceEndsAt: maintenanceEnd.get() ? maintenanceEnd.get().toISOString() : null,
          maintenanceMessage: maintenanceMessage.value,
          maintenanceMessageEn: maintenanceMessageEn.value,
          contactPhone: document.getElementById("contact-phone").value,
          contactEmail: document.getElementById("contact-email").value
        })
      });
      updated = await res.json();
    } catch (err) {
      endSaving();
      showActionResult(false, t("result.network"));
      return;
    }
    if (!res.ok) {
      endSaving();
      const errorKeys = {
        "maintenance-end-before-start": "settings.maint.err.endBeforeStart",
        "maintenance-end-in-past": "settings.maint.err.endInPast",
        "maintenance-date-invalid": "settings.maint.err.dateInvalid"
      };
      if (updated && updated.error === "contact-email-invalid") {
        document.getElementById("contact-email-field").classList.add("invalid");
        showActionResult(false, t("settings.contact.emailError"));
        return;
      }
      const errorKey = errorKeys[updated && updated.error];
      if (errorKey) showEndError(errorKey);
      showActionResult(false, t(errorKey || "result.generic"));
      return;
    }
    document.getElementById("contact-email-field").classList.remove("invalid");
    maintenanceWasOn = maintenanceToggle.checked;
    setScheduleInputs(updated.maintenanceStartsAt, updated.maintenanceEndsAt);
    renderMaintenanceStatus();
    // If the English field was left blank, the server auto-translated —
    // reflect the result back so the admin can see/edit it without reloading.
    maintenanceMessageEn.value = updated.maintenanceMessageEn || "";
    contactEmailInput.value = updated.contactEmail != null ? updated.contactEmail : contactEmailInput.value;
    contactPhoneInput.value = updated.contactPhone != null ? updated.contactPhone : contactPhoneInput.value;
    savedState = readForm();
    justSaved = true;
    saving = false;
    showSaveCheckmark();
    updateSaveBar();
    showActionResult(true, t("settings.savedMsgFull"));
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    if (!validateSchedule()) return;
    const turningOn = maintenanceToggle.checked && !maintenanceWasOn;
    if (turningOn) {
      const start = maintenanceStart.get();
      const message = start && start > new Date()
        ? t("settings.maint.confirmMessageScheduled").replace("{start}", formatDateTime(start, getLang()))
        : t("settings.maint.confirmMessage");
      showConfirmModal({
        title: t("settings.maint.confirmTitle"),
        message: message,
        confirmText: t("settings.saveBtn"),
        danger: true,
        onConfirm: saveSettings
      });
      return;
    }
    saveSettings();
  });
</script>
</body>
</html>
