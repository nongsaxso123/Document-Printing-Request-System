<%- include("../partials/head", { title: "บันทึกการใช้งานระบบ | ฝ่ายทะเบียน มฟล." }) %>
<%- include("../partials/sidebar", { user, active }) %>
<%- include("../partials/header", { user, crumbKey: "crumb.adminAccessLog", crumbFallback: "บันทึกการใช้งานระบบ / <strong>ภาพรวม</strong>" }) %>

  <main class="app-main">
    <h1 class="page-title" data-i18n="accessLog.title">บันทึกการใช้งานระบบ</h1>
    <p class="page-subtitle" data-i18n="accessLog.subtitle">บันทึกว่าใครเข้าสู่ระบบและทำอะไรกับคำขอ เมื่อไร จากที่ไหน เก็บไว้อย่างน้อย 90 วันตาม พ.ร.บ.คอมพิวเตอร์ มาตรา 26 เรียงจากล่าสุด</p>

    <div class="card filter-panel">
      <div class="card-body">
        <div class="filter-top">
          <div class="filter-search">
            <span class="icon filter-search-icon" data-icon="search"><%- icon('search') %></span>
            <input type="text" id="search-input" data-i18n-placeholder="accessLog.searchPlaceholder"
                   placeholder="ค้นหาอีเมล IP หรือเลขคำขอ">
          </div>
          <button type="button" class="btn btn-secondary filter-toggle" id="access-filter-toggle" aria-expanded="false" aria-controls="access-filter-body">
              <span data-i18n="filter.toggle">ตัวกรอง</span>
              <span class="filter-toggle-count" id="access-filter-count" hidden></span>
              <span class="icon filter-toggle-chevron" data-icon="chevron-down"><%- icon('chevron-down') %></span>
            </button>
        </div>
        <div class="filter-collapse" id="access-filter-body">
        <div class="filter-collapse-inner">
        <div class="filter-row">
          <div class="filter-group">
            <div class="filter-head"><span class="filter-label" data-i18n="filter.category">หมวด</span></div>
            <div class="filter-controls">
              <select id="type-filter" class="toolbar-select"></select>
            </div>
          </div>

          <div class="filter-group">
            <div class="filter-head"><span class="filter-label" data-i18n="filter.action">การดำเนินการ</span></div>
            <div class="filter-controls">
              <select id="action-filter" class="toolbar-select"></select>
            </div>
          </div>

          <div class="filter-group">
            <div class="filter-head"><span class="filter-label" data-i18n="filter.dateRange">ช่วงวันที่</span></div>
            <div class="filter-controls">
              <input type="date" id="from-date" class="toolbar-select" aria-label="From date">
              <span class="filter-to" data-i18n="dashboard.dateMode.rangeTo">ถึง</span>
              <input type="date" id="to-date" class="toolbar-select" aria-label="To date">
              <button type="button" id="filter-clear-btn" class="filter-clear" data-i18n="dashboard.dateMode.clear">ล้าง</button>
            </div>
          </div>
        </div>
        </div>
        </div>
      </div>
    </div>

    <div class="card admin-card">
      <div class="card-header">
        <span id="access-result-count"></span>
        <label style="display:flex; align-items:center; gap:8px; font-weight:400; font-size:13px;">
          <span data-i18n="history.rowsPerPage">แสดงต่อหน้า</span>
          <select id="page-size-select" style="padding:6px 10px; border:1px solid var(--color-border); border-radius:8px; font-family:var(--font-family); font-size:13px;">
            <option value="20">20</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
          </select>
        </label>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="data-table">
          <thead>
            <tr>
              <th style="white-space:nowrap;" data-i18n="auditLog.th.time">เวลา</th>
              <th data-i18n="accessLog.th.user">ผู้ใช้</th>
              <th style="white-space:nowrap;" data-i18n="accessLog.th.ip">IP address</th>
              <th data-i18n="auditLog.th.action">การดำเนินการ</th>
              <th data-i18n="auditLog.th.entity">รายการ</th>
            </tr>
          </thead>
          <tbody id="access-table-body"></tbody>
        </table>
      </div>
      <div class="card-body" style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid var(--color-border);">
        <span id="access-page-info" style="font-size:13px; color:var(--color-muted);"></span>
        <div style="display:flex; gap:8px;">
          <button class="btn btn-secondary" id="prev-page-btn" data-i18n="history.prevPage">‹ ก่อนหน้า</button>
          <button class="btn btn-secondary" id="next-page-btn" data-i18n="history.nextPage">ถัดไป ›</button>
        </div>
      </div>
    </div>
  </main>

<%- include("../partials/foot") %>
<script>
  // Reads the same audit_log table as admin/audit-log.ejs, but only the
  // sign-in and printing-request rows (src/audit.js recordRequest / record).
  const CATEGORIES = [
    { id: "auth", types: "auth", label: "auditLog.type.auth" },
    { id: "request", types: "request", label: "auditLog.type.request" }
  ];
  const ALL_TYPES = CATEGORIES.map(function (c) { return c.types; }).join(",");
  const TYPE_LABEL = { auth: "auditLog.type.auth", request: "auditLog.type.request" };

  // action -> [category, i18n key]
  const ACTIONS = {
    "auth.login": ["auth", "auditLog.action.authLogin"],
    "auth.logout": ["auth", "auditLog.action.authLogout"],
    "auth.loginFailed": ["auth", "auditLog.action.authLoginFailed"],
    "request.submit": ["request", "auditLog.action.requestSubmit"],
    "request.edit": ["request", "auditLog.action.requestEdit"],
    "request.cancel": ["request", "auditLog.action.requestCancel"],
    "request.approve": ["request", "auditLog.action.requestApprove"],
    "request.reject": ["request", "auditLog.action.requestReject"],
    "request.ready": ["request", "auditLog.action.requestReady"],
    "request.handover": ["request", "auditLog.action.requestHandover"]
  };
  // Refused sign-ins keep the reason code as their label.
  const REASON_LABEL = { "domain-not-allowed": "auditLog.reason.domainNotAllowed" };
  const ROLE_LABEL = { Admin: "Admin", Officer: "Officer", Requester: "Requester" };

  const typeFilter = document.getElementById("type-filter");
  const actionFilter = document.getElementById("action-filter");
  const searchInput = document.getElementById("search-input");
  const fromDateInput = document.getElementById("from-date");
  const toDateInput = document.getElementById("to-date");
  const pageSizeSelect = document.getElementById("page-size-select");
  const prevPageBtn = document.getElementById("prev-page-btn");
  const nextPageBtn = document.getElementById("next-page-btn");

  let currentPage = 1;
  let requestSeq = 0; // guards against an older, slower fetch overwriting a newer one's result
  let rowsOnPage = [];

  function escHtml(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  function fillTypeOptions() {
    const keep = typeFilter.value;
    typeFilter.innerHTML = '<option value="">' + escHtml(t("auditLog.filterType.all")) + "</option>" +
      CATEGORIES.map(function (c) { return '<option value="' + c.id + '">' + escHtml(t(c.label)) + "</option>"; }).join("");
    typeFilter.value = keep;
  }

  function fillActionOptions() {
    const keep = actionFilter.value;
    const cat = typeFilter.value;
    const actions = Object.keys(ACTIONS).filter(function (a) { return !cat || ACTIONS[a][0] === cat; });
    actionFilter.innerHTML = '<option value="">' + escHtml(t("auditLog.filterAction.all")) + "</option>" +
      actions.map(function (a) { return '<option value="' + a + '">' + escHtml(t(ACTIONS[a][1])) + "</option>"; }).join("");
    actionFilter.value = actions.indexOf(keep) >= 0 ? keep : "";
  }

  // Wait until typing pauses before asking the server again.
  function debounce(fn, delay) {
    let timer;
    return function () {
      clearTimeout(timer);
      timer = setTimeout(fn, delay);
    };
  }

  function itemText(row) {
    if (row.action === "auth.loginFailed") return REASON_LABEL[row.entityLabel] ? t(REASON_LABEL[row.entityLabel]) : (row.entityLabel || "");
    if (row.entityType === "auth") return ROLE_LABEL[row.entityLabel] || "";
    return row.entityLabel || ""; // request reference number
  }

  function renderRows() {
    const lang = getLang();
    const tbody = document.getElementById("access-table-body");

    if (rowsOnPage.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="empty-state">' + escHtml(t("accessLog.empty")) + "</td></tr>";
      return;
    }

    tbody.innerHTML = rowsOnPage.map(function (row) {
      const action = ACTIONS[row.action] ? t(ACTIONS[row.action][1]) : row.action;
      const type = TYPE_LABEL[row.entityType] ? t(TYPE_LABEL[row.entityType]) : row.entityType;
      return "<tr>" +
        '<td style="white-space:nowrap;">' + escHtml(formatDateTime(new Date(row.createdAt), lang)) + "</td>" +
        "<td>" + escHtml(row.actorEmail) + "</td>" +
        '<td style="white-space:nowrap;">' + escHtml(row.ipAddress || "—") + "</td>" +
        "<td>" + escHtml(action) + "</td>" +
        '<td><span class="audit-type">' + escHtml(type) + "</span>" + escHtml(itemText(row)) + "</td>" +
        "</tr>";
    }).join("");
  }

  async function loadRows() {
    const pageSize = Number(pageSizeSelect.value);
    const cat = CATEGORIES.find(function (c) { return c.id === typeFilter.value; });

    const params = new URLSearchParams();
    params.set("entityType", cat ? cat.types : ALL_TYPES);
    if (actionFilter.value) params.set("action", actionFilter.value);
    if (searchInput.value.trim()) params.set("q", searchInput.value.trim());
    if (fromDateInput.value) params.set("dateFrom", fromDateInput.value);
    if (toDateInput.value) params.set("dateTo", toDateInput.value);
    params.set("page", currentPage);
    params.set("pageSize", pageSize);

    const seq = ++requestSeq;
    const res = await fetch("/api/admin/audit-log?" + params.toString());
    const data = await res.json();
    if (seq !== requestSeq) return; // a newer request has already landed

    const total = data.total;
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > totalPages) { currentPage = totalPages; return loadRows(); }

    const startIdx = (currentPage - 1) * pageSize;
    const from = total === 0 ? 0 : startIdx + 1;
    const to = Math.min(startIdx + pageSize, total);

    document.getElementById("access-result-count").textContent = t("history.resultCount")
      .replace("{from}", from).replace("{to}", to).replace("{total}", total);
    document.getElementById("access-page-info").textContent = t("history.pageInfo")
      .replace("{page}", currentPage).replace("{pages}", totalPages);
    prevPageBtn.disabled = currentPage <= 1;
    nextPageBtn.disabled = currentPage >= totalPages;

    rowsOnPage = data.rows;
    renderRows();
  }

  function onFilterChange() {
    currentPage = 1;
    loadRows();
  }

  function clearFilters() {
    typeFilter.value = "";
    fillActionOptions();
    actionFilter.value = "";
    fromDateInput.value = "";
    toDateInput.value = "";
    onFilterChange();
  }

  typeFilter.addEventListener("change", function () { fillActionOptions(); onFilterChange(); });
  actionFilter.addEventListener("change", onFilterChange);
  searchInput.addEventListener("input", debounce(onFilterChange, 300));
  fromDateInput.addEventListener("change", onFilterChange);
  toDateInput.addEventListener("change", onFilterChange);
  document.getElementById("filter-clear-btn").addEventListener("click", clearFilters);

  initFilterCollapse({
    toggle: "access-filter-toggle", body: "access-filter-body", badge: "access-filter-count", key: "accessLog",
    count: function () {
      let n = 0;
      if (typeFilter.value) n++;
      if (actionFilter.value) n++;
      if (fromDateInput.value || toDateInput.value) n++;
      return n;
    }
  });
  pageSizeSelect.addEventListener("change", onFilterChange);
  prevPageBtn.addEventListener("click", function () { currentPage--; loadRows(); });
  nextPageBtn.addEventListener("click", function () { currentPage++; loadRows(); });

  document.addEventListener("odprs:langchange", function () { fillTypeOptions(); fillActionOptions(); renderRows(); });
  fillTypeOptions();
  fillActionOptions();
  loadRows();
</script>
