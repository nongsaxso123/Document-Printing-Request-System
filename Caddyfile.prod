# Production Caddyfile (docker-compose.prod.yml).
#
# The university reverse proxy sits in front of this server. It holds the
# HTTPS certificate for odpr.mfu.ac.th, terminates HTTPS, and forwards to us
# over plain HTTP on port 80:
#
#   browser --HTTPS 443--> MFU reverse proxy --HTTP 80--> Caddy --> app:3000
#
# So Caddy listens on :80 only and never requests a certificate itself.
# If IT ends up forwarding over HTTPS instead, switch ":80" back to
# "{$DOMAIN}", add "tls internal" (or the cert IT gives you), and map 443 in
# docker-compose.prod.yml.

{
	servers {
		# Only these addresses may tell us "the real client is X"
		# (X-Forwarded-For / X-Forwarded-Proto). Set TRUSTED_PROXIES in
		# server/.env to the MFU proxy's IP once IT gives it. Until then it
		# defaults to private_ranges (any 10.x / 172.16-31.x / 192.168.x).
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

:80 {
	encode gzip

	# Security headers on every response.
	header {
		# Browser: only ever reach this site over HTTPS (1 year). Users reach
		# us over HTTPS via the MFU proxy, so the browser accepts it.
		Strict-Transport-Security "max-age=31536000"
		# Don't guess file types — a file served as text stays text.
		X-Content-Type-Options "nosniff"
		# No other site may show our pages inside a frame (clickjacking).
		X-Frame-Options "SAMEORIGIN"
		# Content Security Policy: pages may only load scripts, styles,
		# images and connections from this site. Exceptions: Google Fonts
		# (Kanit, style.css @import) and Google profile photos (header avatar).
		# 'unsafe-inline' is still needed: page scripts are inline <script>
		# blocks. object-src/base-uri/form-action close the remaining holes.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'self'"
		# Links to other sites get only our domain, never the full URL.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Pages never need camera, microphone, location, etc.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Don't advertise which server software we run.
		-Server
	}

	reverse_proxy app:3000
}
